  eventName: "\u5148\u884C\u7684\u56DE\u58F0"
  eventType: 1
  displayText: "\u65AD\u8DEF\u5C3D\u5934\u4F20\u6765\u961F\u4F0D\u7684\u811A\u6B65\u58F0\uFF0C\u53EF\u6240\u6709\u4EBA\u90FD\u8FD8\u7AD9\u5728\u539F\u5730\u3002\u56DE\u58F0\u4E2D\u6DF7\u7740\u4E00\u6B21\u5E76\u4E0D\u5C5E\u4E8E\u5C0F\u961F\u7684\u843D\u811A\u3002"
  hiddenText: "\u591A\u51FA\u7684\u811A\u6B65\u6700\u7EC8\u505C\u5728\u4E86\u961F\u4F0D\u8EAB\u540E\u3002"
