    checkPresentation: 3
    checkCount: 1
    checkSides: 10
    checkDeckId: broken-road-echo
    checkInstruction: "\u62BD\u53D6\u4E00\u5F20\u811A\u6B65\u724C\uFF0C\u907F\u5F00\u90A3\u5F20\u6C38\u8FDC\u6BD4\u4F60\u5148\u5230\u4E00\u6B65\u7684\u9B3C\u724C"
    successText: "\u4F60\u5728\u56DE\u58F0\u91CC\u6293\u4F4F\u4E86\u4E00\u5757\u9508\u8680\u91D1\u5C5E\u3002\u5B83\u843D\u5730\u540E\uFF0C\u591A\u51FA\u7684\u811A\u6B65\u58F0\u6D88\u5931\u4E86\u3002\u83B7\u5F97\u91D1\u5C5E\u6B8B\u7247 \xD71\u3002"
