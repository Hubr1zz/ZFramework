{
  "schemaVersion": 3,
  "packageVersion": "2026.08.20.7",
  "packageKind": "generic-zworkflow-bootstrap",
  "setupEntry": "setup/SETUP_NEW_PROJECT.md",
  "upgradePolicy": {
    "managedTopLevel": [
      ".agents", ".claude", ".codex", "assets", "bin", "packages", "setup", "test",
      ".gitattributes", "AGENT_WORKFLOW_README.md", "AGENTS.md", "LICENSE", "package.json",
      "PROJECT_WORKFLOW_PACKAGE.md", "README.md", "START_HERE.md", "THIRD_PARTY_NOTICES.md",
      "WORKFLOW_DEVELOPER_GUIDE.md", "WORKFLOW_OVERVIEW.md", "WORKFLOW_QUICKSTART.md"
    ],
    "preserveTopLevel": [
      ".agent-memory", ".agent-bridge", ".design-workflow", "openspec",
      "zWorkFlow Pack", "zWorkFlow Pack.zip"
    ]
  },
  "projectInstall": {
    "statePath": ".agent-memory/zworkflow/install-state.json",
    "memoryNamespace": ".agent-memory/zworkflow",
    "discoverableAgentRoot": ".agents",
    "unityWorkbench": {
      "sourceRoot": "setup/assets",
      "destinationCandidates": ["Assets/Scripts/Editor", "Assets/Editor/zWorkFlow"],
      "files": [
        "AgentWorkbenchSupport.cs",
        "AgentWorkbenchWindow.Changes.cs",
        "AgentWorkbenchWindow.CodeIndex.cs",
        "AgentWorkbenchWindow.cs",
        "AgentWorkbenchWindow.Data.cs",
        "AgentWorkbenchWindow.EditorGuidance.cs",
        "AgentWorkbenchWindow.Engineering.cs",
        "AgentWorkbenchWindow.ImportReports.cs",
        "AgentWorkbenchWindow.Models.cs",
        "AgentWorkbenchWindow.Translations.cs"
      ]
    }
  },
  "runtimeRequirements": {
    "openSpecCli": {
      "requiredForWorkbench": true,
      "minimumVersion": "1.6.0",
      "maximumExclusiveVersion": "2.0.0",
      "nodeMinimumVersion": "20.19.0",
      "npmPackage": "@fission-ai/openspec",
      "installSpec": "@fission-ai/openspec@^1.6.0",
      "verifyCommand": "openspec --version"
    }
  },
  "requiredFiles": [
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json",
    "bin/zworkflow.mjs",
    "test/zworkflow-cli.test.mjs",
    "START_HERE.md",
    "AGENT_WORKFLOW_README.md",
    "AGENTS.md",
    "WORKFLOW_OVERVIEW.md",
    "WORKFLOW_QUICKSTART.md",
    "WORKFLOW_DEVELOPER_GUIDE.md",
    "assets/zworkflow-lifecycle.png",
    ".agents/README.md",
    "setup/SETUP_NEW_PROJECT.md",
    "setup/UPGRADE_EXISTING_INSTALLATION.md",
    "setup/CLI_BOOTSTRAP.md",
    "setup/FEATURE_COVERAGE.md",
    "setup/PROJECT_CONTENT_TEMPLATE.md",
    "setup/UNITY_WORKBENCH_INTEGRATION.md",
    "setup/adapters/registry.json",
    "setup/adapters/registry.schema.json",
    "setup/templates/.agent-memory/zworkflow/local/tool-selection.json",
    "setup/templates/.agent-memory/zworkflow/team/MAINTAINERS.md",
    "setup/templates/.agent-memory/zworkflow/team/members/_TEMPLATE.md",
    "setup/templates/AGENTS.md.template",
    "setup/assets/AgentWorkbenchWindow.cs.template",
    "setup/assets/AgentWorkbenchWindow.ImportReports.cs.template",
    "setup/assets/AgentWorkbenchWindow.Changes.cs.template",
    "setup/assets/AgentWorkbenchWindow.CodeIndex.cs.template",
    "setup/assets/AgentWorkbenchWindow.Data.cs.template",
    "setup/assets/AgentWorkbenchWindow.Models.cs.template",
    "setup/assets/AgentWorkbenchWindow.Translations.cs.template",
    "setup/assets/AgentWorkbenchWindow.EditorGuidance.cs.template",
    "setup/assets/AgentWorkbenchWindow.Engineering.cs.template",
    "setup/assets/AgentWorkbenchSupport.cs.template",
    "setup/templates/openspec/localization.json",
    "setup/templates/openspec/translations/manifest.json"
  ],
  "genericSkills": [
    "architecture-review",
    "openspec-apply-change",
    "openspec-archive-change",
    "openspec-derive-design-specs",
    "openspec-explore",
    "openspec-intake-gate",
    "openspec-propose",
    "openspec-translate",
    "openspec-sync-specs",
    "openspec-update-change",
    "project-doc-sync",
    "project-refactor-queue",
    "project-tooling",
    "reconcile-direct-implementation",
    "team-member-preferences",
    "track-implementation-progress",
    "workflow-refactor",
    "workflow-reflection"
  ],
  "conditionalSkills": [
    {
      "name": "codebase-query",
      "when": "target is a Unity project containing C# under Assets or configured project-local source roots, and PowerShell 7+ (pwsh) is available",
      "fallback": "skip installation and continue with Agent-native rg/source inspection"
    }
  ],
  "generatedProjectSkills": [
    "project-context",
    "project-architecture",
    "project-domain-*"
  ],
  "excludedState": [
    "project-specific knowledge",
    "personal member profiles",
    "machine-local source paths",
    "formal specs and changes",
    "draft or archive history",
    "workbench preferences"
  ],
  "portablePackageExcludes": [
    ".agents/skills/zworkflow-workbench-responsive"
  ],
  "optionalPackages": [
    "packages/document-workflow",
    "packages/document-project-bridge"
  ]
}
