{
  "schemaVersion": 2,
  "verifiedAt": "2026-07-26",
  "selectionMode": "multi-tool-per-team",
  "installSelectionPolicy": "active-or-explicit-only",
  "sharedInstructionSource": "AGENTS.md",
  "sharedSkillSource": ".agents/skills/",
  "sharedRoleSource": ".agents/agent-roles/",
  "localSelectionPathPattern": ".agent-memory/zworkflow/local/tool-selections/<nickname>.json",
  "localSelectionTemplate": "setup/templates/.agent-memory/zworkflow/local/tool-selection.json",
  "modelRoutingPolicy": {
    "automaticSelection": "runtime-verified-unique-match-only",
    "ambiguousSelection": "user-confirm-once-per-member-tool",
    "unsupportedFallback": "inherit-or-single-main-agent",
    "localDecisionPathPattern": ".agent-memory/zworkflow/local/tool-selections/<nickname>.json",
    "userPreferenceOptions": ["cost-first", "balanced", "quality-first", "platform-auto"]
  },
  "modelRequirementProfiles": {
    "economy": {
      "capabilityTier": "economy",
      "reasoningEffort": "low",
      "writeAccess": false,
      "optimizationPriority": ["cost", "latency"],
      "maxTurnsHint": 20
    },
    "coding": {
      "capabilityTier": "coding",
      "reasoningEffort": "medium",
      "writeAccess": true,
      "optimizationPriority": ["coding-quality", "cost"],
      "maxTurnsHint": 40
    },
    "advanced-reasoning": {
      "capabilityTier": "advanced-reasoning",
      "reasoningEffort": "high",
      "writeAccess": false,
      "optimizationPriority": ["reasoning-quality", "coding-quality"],
      "maxTurnsHint": 40
    }
  },
  "roleModelRequirements": {
    "project-query-agent": { "profile": "economy", "permissionMode": "read-only" },
    "wiki-query-agent": { "profile": "economy", "permissionMode": "read-only" },
    "solution-architect": { "profile": "advanced-reasoning", "permissionMode": "read-only" },
    "code-implementer": { "profile": "coding", "permissionMode": "workspace-write" },
    "code-simplifier": { "profile": "coding", "permissionMode": "workspace-write" }
  },
  "adapters": [
    {
      "id": "codex",
      "displayName": "OpenAI Codex",
      "supportLevel": "full",
      "activeRuntimeAliases": ["codex", "openai-codex"],
      "executables": ["codex"],
      "projectMarkers": [".codex/"],
      "instructions": { "mode": "direct", "paths": ["AGENTS.md"] },
      "skills": { "mode": "direct", "paths": [".agents/skills/"] },
      "commands": { "mode": "skill-invocation" },
      "roles": { "mode": "thin-wrapper", "path": ".codex/agents/" },
      "modelRouting": {
        "mode": "explicit",
        "optionSource": "runtime-agent-options",
        "perAgentSelection": "supported",
        "reasoningEffort": "supported",
        "automaticSelection": "verified-mapping",
        "fallback": "warn-and-suggest",
        "profileMappings": {
          "economy": { "selector": "gpt-5.5", "reasoningEffort": "low", "fallbackSelectors": ["gpt-5.6-terra"] },
          "coding": { "selector": "gpt-5.6-sol", "reasoningEffort": "medium" },
          "advanced-reasoning": { "selector": "gpt-5.6-sol", "reasoningEffort": "high" }
        },
        "notes": ["Only apply a configured selector after the active Codex runtime confirms it is available."]
      },
      "install": {
        "mode": "copy-thin-if-missing",
        "artifacts": [
          { "source": ".codex/README.md", "target": ".codex/README.md", "kind": "thin-wrapper" },
          { "source": ".codex/agents/", "target": ".codex/agents/", "kind": "thin-wrapper", "recursive": true }
        ]
      }
    },
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "supportLevel": "full",
      "activeRuntimeAliases": ["claude", "claude-code"],
      "executables": ["claude"],
      "projectMarkers": [".claude/CLAUDE.md"],
      "instructions": { "mode": "thin-wrapper", "paths": [".claude/CLAUDE.md"] },
      "skills": { "mode": "thin-wrapper", "paths": [".claude/skills/"] },
      "commands": { "mode": "thin-wrapper", "path": ".claude/commands/opsx/" },
      "roles": { "mode": "thin-wrapper", "path": ".claude/agents/" },
      "modelRouting": {
        "mode": "explicit",
        "optionSource": "runtime-agent-options",
        "perAgentSelection": "supported",
        "reasoningEffort": "runtime-verify",
        "automaticSelection": "verified-mapping",
        "fallback": "ask-user",
        "profileMappings": {
          "economy": { "selector": "haiku", "reasoningEffort": "low" },
          "coding": { "selector": "sonnet", "reasoningEffort": "medium" },
          "advanced-reasoning": { "selector": "sonnet", "reasoningEffort": "high" }
        },
        "notes": ["Aliases must still be accepted by the active Claude Code runtime before setup writes a missing thin wrapper."]
      },
      "install": {
        "mode": "copy-thin-if-missing",
        "artifacts": [
          { "source": ".claude/CLAUDE.md", "target": ".claude/CLAUDE.md", "kind": "thin-wrapper" },
          { "source": ".claude/skills/", "target": ".claude/skills/", "kind": "thin-wrapper", "recursive": true },
          { "source": ".claude/commands/", "target": ".claude/commands/", "kind": "thin-wrapper", "recursive": true },
          { "source": ".claude/agents/", "target": ".claude/agents/", "kind": "thin-wrapper", "recursive": true }
        ]
      }
    },
    {
      "id": "cursor",
      "displayName": "Cursor",
      "supportLevel": "full",
      "activeRuntimeAliases": ["cursor", "cursor-agent"],
      "executables": ["cursor", "cursor-agent"],
      "projectMarkers": [".cursor/rules/", ".cursor/commands/"],
      "instructions": { "mode": "direct", "paths": ["AGENTS.md"] },
      "skills": { "mode": "direct-with-version-fallback", "paths": [".agents/skills/"] },
      "commands": { "mode": "skill-invocation-or-optional-wrapper", "path": ".cursor/commands/" },
      "roles": { "mode": "shared-role-prompt" },
      "modelRouting": {
        "mode": "runtime-dependent",
        "optionSource": "runtime-agent-options",
        "perAgentSelection": "runtime-verify",
        "reasoningEffort": "runtime-verify",
        "automaticSelection": "unique-runtime-match",
        "fallback": "native-auto",
        "notes": ["Do not infer per-subagent support from the general mode or CLI model picker."]
      },
      "install": { "mode": "shared-direct", "artifacts": [] }
    },
    {
      "id": "github-copilot",
      "displayName": "GitHub Copilot",
      "supportLevel": "full",
      "activeRuntimeAliases": ["copilot", "github-copilot", "copilot-cli"],
      "executables": ["copilot"],
      "projectMarkers": [".github/copilot-instructions.md", ".github/agents/", ".github/prompts/"],
      "instructions": { "mode": "direct", "paths": ["AGENTS.md"] },
      "skills": { "mode": "direct", "paths": [".agents/skills/"] },
      "commands": { "mode": "skill-invocation-or-prompt", "path": ".github/prompts/" },
      "roles": { "mode": "optional-thin-wrapper", "path": ".github/agents/" },
      "modelRouting": {
        "mode": "explicit-or-native-auto",
        "optionSource": "runtime-model-list",
        "perAgentSelection": "supported",
        "reasoningEffort": "runtime-verify",
        "automaticSelection": "unique-runtime-match",
        "fallback": "native-auto",
        "notes": ["Account plan and organization policy can change the model list; never persist an unverified model id."]
      },
      "install": { "mode": "shared-direct", "artifacts": [] }
    },
    {
      "id": "gemini-cli",
      "displayName": "Gemini CLI",
      "supportLevel": "full",
      "activeRuntimeAliases": ["gemini", "gemini-cli"],
      "executables": ["gemini"],
      "projectMarkers": ["GEMINI.md", ".gemini/"],
      "instructions": {
        "mode": "thin-wrapper",
        "paths": ["GEMINI.md"],
        "template": "setup/adapters/gemini-cli/templates/GEMINI.md.template"
      },
      "skills": { "mode": "direct", "paths": [".agents/skills/"] },
      "commands": { "mode": "skill-invocation-or-optional-wrapper", "path": ".gemini/commands/" },
      "roles": { "mode": "shared-role-prompt-or-native", "path": ".gemini/agents/" },
      "modelRouting": {
        "mode": "explicit",
        "optionSource": "runtime-agent-options",
        "perAgentSelection": "supported",
        "reasoningEffort": "unsupported",
        "automaticSelection": "unique-runtime-match",
        "fallback": "ask-user",
        "notes": ["Resolve model ids from the active Gemini CLI agent options or agent configuration UI."]
      },
      "install": {
        "mode": "copy-thin-if-missing",
        "artifacts": [
          { "source": "setup/adapters/gemini-cli/templates/GEMINI.md.template", "target": "GEMINI.md", "kind": "thin-wrapper" }
        ]
      }
    },
    {
      "id": "windsurf",
      "displayName": "Windsurf",
      "supportLevel": "full",
      "activeRuntimeAliases": ["windsurf", "cascade"],
      "executables": ["windsurf"],
      "projectMarkers": [".windsurf/rules/", ".windsurf/workflows/"],
      "instructions": { "mode": "direct", "paths": ["AGENTS.md"] },
      "skills": { "mode": "direct", "paths": [".agents/skills/"] },
      "commands": { "mode": "skill-invocation-or-optional-workflow", "path": ".windsurf/workflows/" },
      "roles": { "mode": "shared-role-prompt" },
      "modelRouting": {
        "mode": "inherit-only",
        "optionSource": "none",
        "perAgentSelection": "unsupported",
        "reasoningEffort": "unsupported",
        "automaticSelection": "never",
        "fallback": "single-main-agent",
        "notes": ["Upgrade this adapter only after the active runtime exposes a verifiable per-agent model contract."]
      },
      "install": { "mode": "shared-direct", "artifacts": [] }
    },
    {
      "id": "kimi-code-cli",
      "displayName": "Kimi Code CLI",
      "supportLevel": "full",
      "activeRuntimeAliases": ["kimi", "kimi-cli", "kimi-code", "kimi-code-cli"],
      "executables": ["kimi"],
      "projectMarkers": ["AGENTS.md", ".kimi-code/AGENTS.md"],
      "instructions": { "mode": "direct", "paths": ["AGENTS.md"] },
      "skills": { "mode": "direct", "paths": [".agents/skills/"] },
      "commands": { "mode": "skill-invocation", "prefix": "/skill:" },
      "roles": { "mode": "runtime-builtins", "builtins": ["explore", "plan", "coder"] },
      "modelRouting": {
        "mode": "primary-secondary",
        "optionSource": "configured-primary-secondary",
        "perAgentSelection": "runtime-verify",
        "reasoningEffort": "unsupported",
        "automaticSelection": "unique-runtime-match",
        "fallback": "inherit",
        "profileMappings": {
          "economy": { "selector": "secondary" },
          "coding": { "selector": "primary" },
          "advanced-reasoning": { "selector": "primary" }
        },
        "notes": ["Use the economy mapping only when the current Kimi mode confirms secondary-model subagent routing is enabled."]
      },
      "install": { "mode": "shared-direct", "artifacts": [] },
      "compatibility": {
        "legacyName": "Kimi CLI",
        "policy": "Prefer current Kimi Code CLI behavior; if the detected version lacks project .agents/skills discovery, keep AGENTS.md as the guaranteed entry and report reduced capability."
      }
    }
  ]
}
