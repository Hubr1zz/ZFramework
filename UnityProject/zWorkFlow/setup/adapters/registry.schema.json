{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zworkflow.local/schemas/ai-tool-adapters-v2.json",
  "title": "zWorkFlow AI Tool Adapter Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "verifiedAt",
    "selectionMode",
    "installSelectionPolicy",
    "sharedInstructionSource",
    "sharedSkillSource",
    "sharedRoleSource",
    "localSelectionPathPattern",
    "modelRoutingPolicy",
    "agentDelegationPolicy",
    "modelRequirementProfiles",
    "roleModelRequirements",
    "adapters"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "verifiedAt": { "type": "string", "format": "date" },
    "selectionMode": { "const": "multi-tool-per-team" },
    "installSelectionPolicy": { "const": "active-or-explicit-only" },
    "sharedInstructionSource": { "type": "string", "minLength": 1 },
    "sharedSkillSource": { "type": "string", "minLength": 1 },
    "sharedRoleSource": { "type": "string", "minLength": 1 },
    "localSelectionPathPattern": {
      "type": "string",
      "pattern": "<nickname>"
    },
    "localSelectionTemplate": { "type": "string", "minLength": 1 },
    "modelRoutingPolicy": { "$ref": "#/$defs/modelRoutingPolicy" },
    "agentDelegationPolicy": { "$ref": "#/$defs/agentDelegationPolicy" },
    "modelRequirementProfiles": {
      "type": "object",
      "required": ["economy", "coding", "advanced-reasoning"],
      "properties": {
        "economy": { "$ref": "#/$defs/modelRequirementProfile" },
        "coding": { "$ref": "#/$defs/modelRequirementProfile" },
        "advanced-reasoning": { "$ref": "#/$defs/modelRequirementProfile" },
        "efficient-read": { "$ref": "#/$defs/modelRequirementProfile" },
        "efficient-execution": { "$ref": "#/$defs/modelRequirementProfile" },
        "realtime-execution": { "$ref": "#/$defs/modelRequirementProfile" }
      },
      "additionalProperties": false
    },
    "roleModelRequirements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/roleModelRequirement" }
    },
    "adapters": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "supportLevel",
          "activeRuntimeAliases",
          "executables",
          "projectMarkers",
          "instructions",
          "skills",
          "commands",
          "roles",
          "modelRouting",
          "install"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "supportLevel": { "enum": ["full", "compatibility", "experimental"] },
          "activeRuntimeAliases": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "executables": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "projectMarkers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "instructions": { "$ref": "#/$defs/capability" },
          "skills": { "$ref": "#/$defs/capability" },
          "commands": { "$ref": "#/$defs/capability" },
          "roles": { "$ref": "#/$defs/capability" },
          "modelRouting": { "$ref": "#/$defs/modelRouting" },
          "install": { "$ref": "#/$defs/install" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "agentDelegationPolicy": {
      "type": "object",
      "required": ["scope", "strategy", "maximumReusableSpecialists", "allowNestedDelegation", "reuseExistingRoleBeforeCreate", "sharedFactPacket", "roles", "auxiliaryWork", "quotaFallback"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "strategy": { "type": "string", "minLength": 1 },
        "maximumReusableSpecialists": { "type": "integer", "minimum": 1 },
        "allowNestedDelegation": { "type": "boolean" },
        "reuseExistingRoleBeforeCreate": { "type": "boolean" },
        "sharedFactPacket": { "type": "string", "minLength": 1 },
        "roles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "optionalExecutionProfiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "auxiliaryWork": { "type": "string", "minLength": 1 },
        "quotaFallback": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "modelRoutingPolicy": {
      "type": "object",
      "required": [
        "automaticSelection",
        "ambiguousSelection",
        "unsupportedFallback",
        "localDecisionPathPattern",
        "userPreferenceOptions"
      ],
      "properties": {
        "automaticSelection": { "const": "runtime-verified-unique-match-only" },
        "ambiguousSelection": { "const": "user-confirm-once-per-member-tool" },
        "unsupportedFallback": { "enum": ["inherit-or-single-main-agent"] },
        "localDecisionPathPattern": { "type": "string", "pattern": "<nickname>" },
        "userPreferenceOptions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["cost-first", "balanced", "quality-first", "platform-auto"] }
        }
      },
      "additionalProperties": false
    },
    "modelRequirementProfile": {
      "type": "object",
      "required": ["capabilityTier", "reasoningEffort", "writeAccess", "optimizationPriority"],
      "properties": {
        "capabilityTier": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "enum": ["low", "medium", "high"] },
        "writeAccess": { "type": "boolean" },
        "optimizationPriority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "maxTurnsHint": { "type": "integer", "minimum": 1 },
        "usageBoundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "roleModelRequirement": {
      "type": "object",
      "required": ["profile", "permissionMode"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "permissionMode": { "enum": ["read-only", "workspace-write"] }
      },
      "additionalProperties": false
    },
    "modelRouting": {
      "type": "object",
      "required": [
        "mode",
        "optionSource",
        "perAgentSelection",
        "reasoningEffort",
        "automaticSelection",
        "fallback"
      ],
      "properties": {
        "mode": {
          "enum": ["explicit", "explicit-or-native-auto", "primary-secondary", "runtime-dependent", "inherit-only"]
        },
        "optionSource": {
          "enum": ["runtime-agent-options", "runtime-model-list", "configured-primary-secondary", "none"]
        },
        "perAgentSelection": { "enum": ["supported", "runtime-verify", "unsupported"] },
        "reasoningEffort": { "enum": ["supported", "runtime-verify", "unsupported"] },
        "automaticSelection": { "enum": ["verified-mapping", "unique-runtime-match", "native-auto-only", "never"] },
        "fallback": { "enum": ["ask-user", "inherit", "native-auto", "single-main-agent", "warn-and-suggest"] },
        "profileMappings": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "$ref": "#/$defs/modelProfileMapping" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "modelProfileMapping": {
      "type": "object",
      "required": ["selector"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "enum": ["low", "medium", "high"] },
        "fallbackSelectors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "template": { "type": "string" }
      },
      "additionalProperties": true
    },
    "install": {
      "type": "object",
      "required": ["mode", "artifacts"],
      "properties": {
        "mode": { "enum": ["shared-direct", "copy-thin-if-missing"] },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["source", "target", "kind"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["thin-wrapper", "tool-config"] },
        "recursive": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
