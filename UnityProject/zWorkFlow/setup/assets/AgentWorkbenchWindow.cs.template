        [MenuItem("Tools/Agent Workflow/Agent Workbench")]
        internal static void Open()
        {
            var window = GetWindow<AgentWorkbenchWindow>();
            var projectRoot = Directory.GetParent(Application.dataPath)?.FullName ?? Directory.GetCurrentDirectory();
            var config = AgentWorkbenchConfigStore.Load(projectRoot);
            window.position = new Rect(
                config.hasSavedWindowPosition ? config.windowPositionX : window.position.x,
                config.hasSavedWindowPosition ? config.windowPositionY : window.position.y,
                Mathf.Max(900f, config.defaultWindowWidth),
                Mathf.Max(600f, config.defaultWindowHeight));
            window.titleContent = new GUIContent(AgentWorkbenchText.Get("window.title"));
            window.Show();
        }

        private void OnEnable()
        {
            minSize = new Vector2(900f, 600f);
            _projectRoot = Directory.GetParent(Application.dataPath)?.FullName ?? Directory.GetCurrentDirectory();
            _config = AgentWorkbenchConfigStore.Load(_projectRoot);
            LoadDependencyGraphLayout();
            _observedWindowRect = position;
            AgentWorkbenchText.SetLanguage(_config.currentLanguage);
            AgentWorkbenchTheme.Apply(_config);
            titleContent = new GUIContent(L("window.title"));
            LoadDesignSourceConfiguration();
            ReloadDocumentImplementationChanges();
            _maintainer = EditorPrefs.GetString(MaintainerPrefKey, ResolveDefaultMaintainer(_projectRoot));
            _queuePath = Path.Combine(
                _projectRoot,
                ".agents",
                "skills",
                "project-refactor-queue",
                "references",
                "REFACTOR_QUEUE.md");
            _openSpecPath = Path.Combine(_projectRoot, "openspec");
            _specMetadataPath = Path.Combine(_openSpecPath, "spec-metadata");
            _designImportsPath = Path.Combine(_openSpecPath, "design-imports");
            _draftStorePath = Path.Combine(_openSpecPath, "drafts");
            _designSourceConfigPath = Path.Combine(_openSpecPath, "design-source.json");
            _engineeringCatalogPath = Path.Combine(
                _projectRoot,
                ".agents",
                "skills",
                "project-tooling",
                "references",
                "tooling-catalog.json");
            LoadDesignSourceConfiguration();
            Reload();
        }

        private void Update()
        {
            if (position != _observedWindowRect)
            {
                _observedWindowRect = position;
                _windowRectChangedAt = EditorApplication.timeSinceStartup;
                _windowRectSavePending = true;
            }

            if (_windowRectSavePending && EditorApplication.timeSinceStartup - _windowRectChangedAt >= 0.5d)
                PersistWindowRect();
            if (_dependencyGraphSavePending &&
                EditorApplication.timeSinceStartup - _dependencyGraphChangedAt >= 0.5d)
                PersistDependencyGraphLayout();
            PollCodeIndexBuild();
        }

        private void OnDisable()
        {
            PersistWindowRect();
            PersistDependencyGraphLayout();
            DisposeMarkdownImages();
        }

        private void PersistWindowRect()
        {
            if (_config == null || string.IsNullOrWhiteSpace(_projectRoot) ||
                float.IsNaN(position.x) || float.IsNaN(position.y) ||
                position.width < minSize.x || position.height < minSize.y)
                return;

            _config.hasSavedWindowPosition = true;
            _config.windowPositionX = position.x;
            _config.windowPositionY = position.y;
            _config.defaultWindowWidth = position.width;
            _config.defaultWindowHeight = position.height;
            AgentWorkbenchConfigStore.Save(_projectRoot, _config);
            _observedWindowRect = position;
            _windowRectSavePending = false;
        }

        private void LoadDependencyGraphLayout()
        {
            _dependencyGraphPositions.Clear();
            if (_config == null)
                return;
            _dependencyGraphPan = new Vector2(_config.dependencyGraphPanX, _config.dependencyGraphPanY);
            _dependencyGraphZoom = Mathf.Clamp(_config.dependencyGraphZoom, 0.55f, 1.8f);
            _dependencyGraphLayoutSignature = _config.dependencyGraphLayoutSignature;
            foreach (var item in _config.dependencyGraphNodePositions ??
                                 Array.Empty<DependencyGraphNodePosition>())
            {
                if (item == null || string.IsNullOrWhiteSpace(item.nodeId) ||
                    float.IsNaN(item.x) || float.IsInfinity(item.x) ||
                    float.IsNaN(item.y) || float.IsInfinity(item.y))
                    continue;
                _dependencyGraphPositions[item.nodeId] = new Vector2(item.x, item.y);
            }
        }

        private void MarkDependencyGraphLayoutChanged()
        {
            _dependencyGraphChangedAt = EditorApplication.timeSinceStartup;
            _dependencyGraphSavePending = true;
        }

        private void PersistDependencyGraphLayout()
        {
            if (_config == null || string.IsNullOrWhiteSpace(_projectRoot))
                return;
            _config.dependencyGraphPanX = _dependencyGraphPan.x;
            _config.dependencyGraphPanY = _dependencyGraphPan.y;
            _config.dependencyGraphZoom = _dependencyGraphZoom;
            _config.dependencyGraphLayoutSignature = _dependencyGraphLayoutSignature ?? string.Empty;
            _config.dependencyGraphNodePositions = _dependencyGraphPositions
                .OrderBy(item => item.Key, StringComparer.OrdinalIgnoreCase)
                .Select(item => new DependencyGraphNodePosition
                {
                    nodeId = item.Key,
                    x = item.Value.x,
                    y = item.Value.y
                })
                .ToArray();
            AgentWorkbenchConfigStore.Save(_projectRoot, _config);
            _dependencyGraphSavePending = false;
        }

        private void OnGUI()
        {
            var previousBackground = GUI.backgroundColor;
            var previousLabelColor = GUI.skin.label.normal.textColor;
            var primaryText = AgentWorkbenchTheme.IsDarkMode
                ? AgentWorkbenchTheme.DarkPrimaryText
                : AgentWorkbenchTheme.LightPrimaryText;
            var mutedText = AgentWorkbenchTheme.IsDarkMode
                ? new Color(0.70f, 0.73f, 0.78f)
                : new Color(0.32f, 0.35f, 0.40f);
            var themedStyles = new[]
            {
                EditorStyles.label,
                EditorStyles.boldLabel,
                EditorStyles.wordWrappedLabel,
                EditorStyles.helpBox,
                EditorStyles.miniLabel,
                EditorStyles.miniBoldLabel,
                EditorStyles.wordWrappedMiniLabel,
                EditorStyles.centeredGreyMiniLabel
            };
            var previousStyleColors = themedStyles.Select(style => style.normal.textColor).ToArray();
            EditorGUI.DrawRect(
                new Rect(0, 0, position.width, position.height),
                AgentWorkbenchTheme.IsDarkMode ? AgentWorkbenchTheme.DarkBackground : AgentWorkbenchTheme.LightBackground);
            GUI.backgroundColor = AgentWorkbenchTheme.IsDarkMode
                ? AgentWorkbenchTheme.DarkControlTint
                : AgentWorkbenchTheme.LightControlTint;
            GUI.skin.label.normal.textColor = AgentWorkbenchTheme.IsDarkMode
                ? AgentWorkbenchTheme.DarkPrimaryText
                : AgentWorkbenchTheme.LightPrimaryText;
            for (var index = 0; index < themedStyles.Length; index++)
                themedStyles[index].normal.textColor = index >= 4 ? mutedText : primaryText;

            DrawToolbar();

            var visibleTabs = new[]
            {
                ToolTab.RefactorQueue,
                ToolTab.OpenSpec,
                ToolTab.CodeIndex,
                ToolTab.ImportReports
            };
            var selectedTabIndex = Array.IndexOf(visibleTabs, _tab);
            var nextTabIndex = DrawUniformTabs(
                selectedTabIndex,
                new[] { L("main.refactor"), L("main.openSpec"), L("main.codeIndex"), L("main.imports") },
                MainEntryButtonStyle(),
                MainEntryButtonHeight);
            if (nextTabIndex >= 0 && nextTabIndex != selectedTabIndex && TryLeaveRawEditor())
                _tab = visibleTabs[nextTabIndex];
            EditorGUILayout.Space(6);

            switch (_tab)
            {
                case ToolTab.RefactorQueue:
                    DrawRefactorQueueTab();
                    break;
                case ToolTab.OpenSpec:
                    DrawOpenSpecTab();
                    break;
                case ToolTab.EngineeringCapabilities:
                    DrawEngineeringCapabilities();
                    break;
                case ToolTab.DesignDocumentTree:
                    DrawDesignDocumentTreeTab();
                    break;
                case ToolTab.CodeIndex:
                    DrawCodeIndexTab();
                    break;
                case ToolTab.CommandList:
                    DrawCommandList();
                    break;
                case ToolTab.ImportReports:
                    DrawImportReportsTab();
                    break;
                case ToolTab.Configuration:
                    DrawConfiguration();
                    break;
                case ToolTab.Introduction:
                    DrawIntroduction();
                    break;
                case ToolTab.DependencyGraph:
                    DrawDependencyGraph();
                    break;
            }

            GUI.backgroundColor = previousBackground;
            GUI.skin.label.normal.textColor = previousLabelColor;
            for (var index = 0; index < themedStyles.Length; index++)
                themedStyles[index].normal.textColor = previousStyleColors[index];
        }

        private void DrawToolbar()
        {
            using (new EditorGUILayout.HorizontalScope(EditorStyles.toolbar))
            {
                if (GUILayout.Button(L("toolbar.refresh"), EditorStyles.toolbarButton, GUILayout.Width(115)))
                {
                    if (TryLeaveRawEditor())
                        Reload();
                }

                if (GUILayout.Button(L("toolbar.graph"), EditorStyles.toolbarButton, GUILayout.Width(115)))
                {
                    if (TryLeaveRawEditor())
                        _tab = ToolTab.DependencyGraph;
                }

                if (GUILayout.Button(L("toolbar.engineering"), EditorStyles.toolbarButton, GUILayout.Width(115)))
                {
                    if (TryLeaveRawEditor())
                        _tab = ToolTab.EngineeringCapabilities;
                }

                if (GUILayout.Button(L("toolbar.designDocumentTree"), EditorStyles.toolbarButton, GUILayout.Width(115)))
                {
                    if (TryLeaveRawEditor())
                        _tab = ToolTab.DesignDocumentTree;
                }

                GUILayout.FlexibleSpace();
                if (GUILayout.Button(
                        new GUIContent(
                            L("toolbar.projectRoot"),
                            $"{L("toolbar.openRoot")}\n{_projectRoot}"),
                        EditorStyles.toolbarButton,
                        GUILayout.Width(88)))
                    OpenPath(_projectRoot);

                if (GUILayout.Button(
                        L("toolbar.commandList"),
                        EditorStyles.toolbarButton,
                        GUILayout.Width(115)))
                {
                    if (TryLeaveRawEditor())
                        _tab = ToolTab.CommandList;
                }

                if (GUILayout.Button(L("toolbar.config"), EditorStyles.toolbarButton, GUILayout.Width(101)))
                {
                    if (TryLeaveRawEditor())
                        _tab = ToolTab.Configuration;
                }

                if (GUILayout.Button(L("toolbar.introduction"), EditorStyles.toolbarButton, GUILayout.Width(101)))
                {
                    if (TryLeaveRawEditor())
                        _tab = ToolTab.Introduction;
                }

                if (GUILayout.Button(
                        L(AgentWorkbenchTheme.IsDarkMode ? "toolbar.normal" : "toolbar.dark"),
                        EditorStyles.toolbarButton,
                        GUILayout.Width(137)))
                {
                    _config.themeMode = AgentWorkbenchTheme.IsDarkMode ? "normal" : "dark";
                    SaveWorkbenchConfig();
                }

                GUILayout.Label(
                    L("toolbar.documentBridge"),
                    EditorStyles.miniLabel,
                    GUILayout.Width(88));
                DrawStatusLight(_documentBridgeConnected);
            }
        }

        private void DrawRefactorQueueTab()
        {
            if (!string.IsNullOrEmpty(_loadError))
            {
                EditorGUILayout.HelpBox(_loadError, MessageType.Warning);
                return;
            }

            using (new EditorGUILayout.HorizontalScope())
            {
                EditorGUILayout.LabelField(L("queue.maintainer"), EditorStyles.boldLabel, GUILayout.Width(60));
                var newMaintainer = EditorGUILayout.TextField(_maintainer, GUILayout.Width(130));
                if (newMaintainer != _maintainer)
                {
                    _maintainer = newMaintainer;
                    EditorPrefs.SetString(MaintainerPrefKey, _maintainer);
                }

                GUILayout.Space(8);
                EditorGUILayout.LabelField(L("queue.note"), EditorStyles.boldLabel, GUILayout.Width(92));
                _maintenanceNote = EditorGUILayout.TextField(_maintenanceNote, GUILayout.ExpandWidth(true));
            }

            EditorGUILayout.Space(8);
            _queueStatusTab = (QueueStatusTab)DrawUniformTabs(
                (int)_queueStatusTab,
                new[]
                {
                    $"{L("queue.pending")}（{QueueItemsFor(QueueStatusTab.Pending).Count()}）",
                    $"{L("queue.progress")}（{QueueItemsFor(QueueStatusTab.InProgress).Count()}）",
                    $"{L("queue.done")}（{QueueItemsFor(QueueStatusTab.Maintained).Count()}）"
                },
                TabButtonStyle(),
                TabButtonHeight);
            EditorGUILayout.Space(4);

            _scrollPosition.x = 0f;
            _scrollPosition = EditorGUILayout.BeginScrollView(
                _scrollPosition,
                GUIStyle.none,
                GUI.skin.verticalScrollbar);
            var visibleItems = QueueItemsFor(_queueStatusTab).ToList();
            if (visibleItems.Count == 0)
                EditorGUILayout.HelpBox(L("queue.empty"), MessageType.Info);
            foreach (var item in visibleItems)
                DrawItem(item);
            EditorGUILayout.EndScrollView();
        }

        private IEnumerable<QueueItem> QueueItemsFor(QueueStatusTab statusTab)
        {
            return statusTab switch
            {
                QueueStatusTab.Maintained => _items.Where(item => item.Status == "已维护"),
                QueueStatusTab.InProgress => _items.Where(item => item.Status == "进行中"),
                _ => _items.Where(item => item.Status != "已维护" && item.Status != "进行中")
            };
        }

        private void DrawOpenSpecTab()
        {
            if (!Directory.Exists(_openSpecPath))
            {
                EditorGUILayout.HelpBox(AgentWorkbenchText.Format("spec.missingRoot", _openSpecPath), MessageType.Info);
                return;
            }

            if (!string.IsNullOrEmpty(_specMetadataError))
                EditorGUILayout.HelpBox(_specMetadataError, MessageType.Warning);

            using (new EditorGUILayout.HorizontalScope())
            {
                EditorGUILayout.LabelField($"Specs：{_specFiles.Count}", EditorStyles.boldLabel, GUILayout.Width(120));
                EditorGUILayout.LabelField($"Open Changes：{_openChanges.Count}", EditorStyles.boldLabel, GUILayout.Width(180));
                EditorGUILayout.LabelField($"{L("common.missing")}：{_specGaps.Count(gap => gap.status != "resolved")}", EditorStyles.boldLabel, GUILayout.Width(120));
            }

            var nextOpenSpecSection = (OpenSpecSection)DrawUniformTabs(
                (int)_openSpecSection,
                new[] { L("spec.formal"), L("spec.changes") },
                TabButtonStyle(),
                TabButtonHeight);
            if (nextOpenSpecSection != _openSpecSection && TryLeaveRawEditor())
                _openSpecSection = nextOpenSpecSection;
            EditorGUILayout.Space(4);

            switch (_openSpecSection)
            {
                case OpenSpecSection.Specs:
                    DrawSpecsPanel();
                    break;
                case OpenSpecSection.Changes:
                    DrawChangesPanel();
                    break;
            }
        }

        private void DrawSpecsPanel()
        {
            DrawSpecFolderControls();
            EditorGUILayout.Space(4);

            var visibleSpecs = new List<SpecFile>();

            using (new EditorGUILayout.HorizontalScope(GUILayout.ExpandHeight(true)))
            {
                using (new EditorGUILayout.VerticalScope(ReportPanelStyle(), GUILayout.Width(270), GUILayout.ExpandHeight(true)))
                {
                    DrawSpecCategoryTabs();
                    EditorGUILayout.Space(4);
                    visibleSpecs = SpecsForCategory(_specCategoryTab).Where(SpecMatchesFolderFilter).ToList();
                    if (_selectedSpec == null || !visibleSpecs.Contains(_selectedSpec))
                        _selectedSpec = visibleSpecs.FirstOrDefault();
                    EditorGUILayout.LabelField($"{L("spec.list")}（{visibleSpecs.Count}）", ReportHeaderStyle());
                    _specListScroll = BeginVerticalScrollView(_specListScroll, GUILayout.ExpandHeight(true));
                    if (visibleSpecs.Count == 0)
                        EditorGUILayout.HelpBox(L("spec.empty"), MessageType.Info);
                    foreach (var spec in visibleSpecs)
                        DrawSpecListItem(spec);
                    EditorGUILayout.EndScrollView();
                }

                GUILayout.Space(6);
                using (new EditorGUILayout.VerticalScope(ReportPanelStyle(), GUILayout.ExpandWidth(true), GUILayout.ExpandHeight(true)))
                {
                    if (_selectedSpec == null)
                    {
                        var selectedFolder = SelectedCustomFolder();
                        if (selectedFolder != null && !FolderHasAnyFormalEntry(selectedFolder.id))
                            DrawEmptyFormalFolderPanel(selectedFolder);
                        else
                            EditorGUILayout.HelpBox(L("spec.empty"), MessageType.Info);
                    }
                    else
                        DrawSpecDetail(_selectedSpec);
                }
            }
        }

