                                var fullPath = Path.GetFullPath(selected);
                                if (_designDocumentSources.Where((_, candidateIndex) => candidateIndex != index)
                                    .Any(candidate => string.Equals(Path.GetFullPath(candidate.path), fullPath,
                                        StringComparison.OrdinalIgnoreCase)))
                                    _designSourceStatus = L("sync.duplicatePath");
                                else
                                {
                                    source.path = fullPath;
                                    SaveDesignSourceConfiguration();
                                }
                            }
                        }
                        if (GUILayout.Button(L("sync.remove"), GUILayout.Width(52)))
                            removeIndex = index;
                        GUI.enabled = true;
                    }
                }

                if (removeIndex >= 0)
                {
                    _designDocumentSources.RemoveAt(removeIndex);
                    SaveDesignSourceConfiguration();
                }

                if (GUILayout.Button(L("sync.addDocuments"), GUILayout.Height(24)))
                {
                    var selected = EditorUtility.OpenFolderPanel(
                        L("sync.chooseDocuments"),
                        _projectRoot,
                        string.Empty);
                    if (!string.IsNullOrWhiteSpace(selected))
                        AddDesignDocumentSource(selected);
                }
                EditorGUILayout.LabelField(LocalizeStatus(_designSourceStatus), EditorStyles.miniLabel);
            }
        }

        private void DrawDocumentBridgeSettings()
        {
            using (new EditorGUILayout.VerticalScope("box"))
            {
                using (new EditorGUILayout.HorizontalScope())
                {
                    GUILayout.Label(
                        $"{L("sync.bridgeStatus")} · {LocalizeStatus(_documentChangeStatus)}",
                        EditorStyles.wordWrappedLabel,
                        GUILayout.ExpandWidth(true));
                    GUILayout.FlexibleSpace();

                    GUI.enabled = _designDocumentSources.Any(source => source != null &&
                        !string.IsNullOrWhiteSpace(source.path) && Directory.Exists(source.path));
                    if (GUILayout.Button(L("sync.checkNow"), GUILayout.Width(78)))
                        ReloadDocumentImplementationChanges();
                    GUI.enabled = true;
                }

                if (_changedImplementedDocuments.Count == 0)
                    EditorGUILayout.HelpBox(L("sync.noImplementedChanges"), MessageType.None);

                EditorGUILayout.LabelField(
                    L("sync.bridgeHint"),
                    EditorStyles.miniLabel);
            }
        }

        private void DrawDesignDocumentStructure()
        {
            using (new EditorGUILayout.VerticalScope("box"))
            {
                using (new EditorGUILayout.HorizontalScope())
                {
                    EditorGUILayout.LabelField(
                        AgentWorkbenchText.Format("sync.documentStructure", _designDocumentTreeItems.Count(item => !item.isDirectory)),
                        EditorStyles.boldLabel);
                }

                if (!string.IsNullOrWhiteSpace(_documentStructureError))
                    EditorGUILayout.HelpBox(_documentStructureError, MessageType.Warning);

                if (!_documentBridgeConnected)
                {
                    EditorGUILayout.LabelField(L("sync.connectPackageToViewStructure"), EditorStyles.miniLabel);
                    return;
                }

                if (_designDocumentTreeItems.Count == 0)
                {
                    EditorGUILayout.LabelField(L("sync.noDesignDocuments"), EditorStyles.miniLabel);
                    return;
                }

                _designDocumentTreeScroll = BeginVerticalScrollView(
                    _designDocumentTreeScroll,
                    GUILayout.MinHeight(150),
                    GUILayout.MaxHeight(420));
                var visibleDirectories = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                foreach (var item in _designDocumentTreeItems)
                {
                    var visible = string.IsNullOrWhiteSpace(item.parentKey) ||
                                  (_expandedDesignDocumentNodes.Contains(item.parentKey) &&
                                   visibleDirectories.Contains(item.parentKey));
                    if (!visible)
                        continue;
                    using (new EditorGUILayout.HorizontalScope(item.isDirectory ? EditorStyles.helpBox : GUIStyle.none))
                    {
                        GUILayout.Space(Mathf.Min(160, item.depth * 16));
                        if (item.isDirectory)
                        {
                            visibleDirectories.Add(item.treeKey);
                            var expanded = _expandedDesignDocumentNodes.Contains(item.treeKey);
                            var nextExpanded = EditorGUILayout.Foldout(
                                expanded,
                                new GUIContent(item.displayName, Or(item.absolutePath, item.relativePath)),
                                true,
                                EditorStyles.foldoutHeader);
                            if (nextExpanded != expanded)
                            {
                                if (nextExpanded)
                                    _expandedDesignDocumentNodes.Add(item.treeKey);
                                else
                                    _expandedDesignDocumentNodes.Remove(item.treeKey);
                            }
                            continue;
                        }

                        EditorGUILayout.LabelField(
                            new GUIContent(item.displayName, item.relativePath),
                            GUILayout.MinWidth(150),
                            GUILayout.ExpandWidth(true));
                        var progressRect = GUILayoutUtility.GetRect(125, 18, GUILayout.Width(125));
                        EditorGUI.ProgressBar(
                            progressRect,
                            item.implementationProgress / 100f,
                            $"{LocalizeImplementationStatus(item.implementationStatus)} {item.implementationProgress}%");
                        EditorGUILayout.LabelField(
                            L(item.changedAfterImplementation ? "sync.changedYes" : "sync.changedNo"),
                            EditorStyles.miniLabel,
                            GUILayout.Width(92));
                        EditorGUILayout.LabelField(
                            Or(item.changeSummary, "-"),
                            EditorStyles.wordWrappedMiniLabel,
                            GUILayout.Width(230));
                        GUI.enabled = File.Exists(item.absolutePath);
                        if (GUILayout.Button(L("sync.open"), GUILayout.Width(56)))
                            OpenMarkdownDocument(item.absolutePath);
                        GUI.enabled = true;
                    }
                }
                EditorGUILayout.EndScrollView();
            }
        }

        private string LocalizeImplementationStatus(string status)
        {
            return status?.Trim().ToLowerInvariant() switch
            {
                "implemented" => L("sync.statusImplemented"),
                "in-progress" => L("sync.statusInProgress"),
                _ => L("sync.statusNotImplemented")
            };
        }

        private static void DrawStatusLight(bool enabled)
        {
            var style = new GUIStyle(EditorStyles.label)
            {
                alignment = TextAnchor.MiddleCenter,
                fontSize = 15
            };
            style.normal.textColor = enabled
                ? new Color(0.2f, 0.82f, 0.32f)
                : new Color(0.45f, 0.45f, 0.45f);
            GUILayout.Label(
                "●",
                style,
                GUILayout.Width(16),
                GUILayout.Height(18));
        }

        private static void DrawDesignImportHint()
        {
            using (new EditorGUILayout.VerticalScope(ReportSectionStyle()))
            {
                EditorGUILayout.LabelField(L("sync.instructions"), ReportHeaderStyle());
                DrawInstruction(L("cmd.importAll"), L("cmd.importAllDesc"));
                DrawInstruction(L("cmd.importScope"), L("cmd.importScopeDesc"));
                DrawInstruction(L("cmd.rules"), L("cmd.rulesDesc"));
                DrawInstruction(L("cmd.content"), L("cmd.contentDesc"));
                DrawInstruction(L("cmd.art"), L("cmd.artDesc"));
                DrawInstruction(L("cmd.checkDocumentFreshness"), L("cmd.checkDocumentFreshnessDesc"));
                DrawInstruction(L("cmd.revise"), L("cmd.reviseDesc"));
                DrawInstruction(L("cmd.translateSpecs"), L("cmd.translateSpecsDesc"));
                DrawInstruction(L("cmd.syncSpecTranslations"), L("cmd.syncSpecTranslationsDesc"));
                DrawInstruction(L("cmd.apply"), L("cmd.applyDesc"));
                DrawInstruction(L("cmd.syncSpecs"), L("cmd.syncSpecsDesc"));
                DrawInstruction(L("cmd.archive"), L("cmd.archiveDesc"));
            }
        }

        private static void DrawInstruction(string command, string description)
        {
            using (new EditorGUILayout.HorizontalScope())
            {
                EditorGUILayout.SelectableLabel(
                    command,
                    EditorStyles.textField,
                    GUILayout.Width(210),
                    GUILayout.Height(EditorGUIUtility.singleLineHeight));
                EditorGUILayout.LabelField(description, ReportMiniWrapStyle(), GUILayout.ExpandWidth(true));
            }
        }

        private static string L(string id) => AgentWorkbenchText.Get(id);

    }

#if UNITY_6000_3_OR_NEWER
    internal static class AgentWorkbenchMainToolbar
    {
