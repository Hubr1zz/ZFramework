        private IEnumerable<DependencyEdge> ChangeGraphEdges()
        {
            foreach (var change in _openChanges)
            {
                var targets = change.SyncTargets.Count > 0
                    ? change.SyncTargets.Select(target => target.capability)
                    : change.Capabilities;
                foreach (var capability in targets
                             .Where(item => !string.IsNullOrWhiteSpace(item))
                             .Distinct(StringComparer.OrdinalIgnoreCase))
                {
                    yield return new DependencyEdge
                    {
                        id = $"{GraphChangeNodeId(change)}--targets--{capability}",
                        from = GraphChangeNodeId(change),
                        to = capability,
                        type = "targets",
                        status = change.SpecSyncStatus,
                        reason = L("graph.changeTargetsSpec"),
                        blocksImplementation = false
                    };
                }
            }
        }

        private void SelectGraphChange(ChangeEntry change)
        {
            if (change == null)
                return;
            _tab = ToolTab.OpenSpec;
            _openSpecSection = OpenSpecSection.Changes;
            _changeCategoryTab = SpecCategoryTab.All;
            _changeFolderFilterIndex = 0;
            _selectedChange = change;
            _changeDetailScroll = Vector2.zero;
        }

        private List<ChangeEntry> PendingDeltaChanges(string capability)
        {
            return _openChanges
                .Where(change => !string.Equals(change.SpecSyncStatus, "synced", StringComparison.OrdinalIgnoreCase) &&
                                 (change.SyncTargets.Count > 0
                                     ? change.SyncTargets.Any(item => string.Equals(
                                         item.capability,
                                         capability,
                                         StringComparison.OrdinalIgnoreCase))
                                     : change.Capabilities.Any(item => string.Equals(
                                         item,
                                         capability,
                                         StringComparison.OrdinalIgnoreCase))))
                .OrderBy(change => change.Title)
                .ToList();
        }

        private string DeltaSyncStatus(ChangeEntry change)
        {
            if (string.Equals(change.SyncValidation?.status, "conflict", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(change.SpecSyncStatus, "blocked-by-conflict", StringComparison.OrdinalIgnoreCase))
                return L("graph.syncConflict");
            if (string.Equals(change.SyncValidation?.status, "review-required", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(change.SpecSyncStatus, "merge-review-required", StringComparison.OrdinalIgnoreCase))
                return L("graph.mergeReview");
            if (string.Equals(change.SyncValidation?.status, "merge-safe", StringComparison.OrdinalIgnoreCase))
                return L("graph.mergeSafe");
            return Or(change.SpecSyncStatus, "pending");
        }

