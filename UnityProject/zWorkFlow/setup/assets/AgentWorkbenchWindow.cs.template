        private static Color GraphStatusTextColor(string readiness) =>
            ((readiness ?? string.Empty).ToLowerInvariant(), AgentWorkbenchTheme.IsDarkMode) switch
        {
            ("pending-sync", true) => new Color(0.28f, 0.84f, 1f),
            ("pending-sync", false) => new Color(0.02f, 0.43f, 0.62f),
            ("in-progress", true) => new Color(0.72f, 0.68f, 1f),
            ("in-progress", false) => new Color(0.35f, 0.28f, 0.68f),
            ("delta-pending", true) => new Color(1f, 0.64f, 0.20f),
            ("delta-pending", false) => new Color(0.72f, 0.34f, 0.03f),
            ("implemented", true) => new Color(0.34f, 0.88f, 0.48f),
            ("implemented", false) => new Color(0.05f, 0.46f, 0.18f),
            ("blocked", true) => new Color(1f, 0.36f, 0.30f),
            ("blocked", false) => new Color(0.73f, 0.12f, 0.08f),
            (_, true) => new Color(0.68f, 0.72f, 0.78f),
            _ => new Color(0.36f, 0.40f, 0.46f)
        };

        private string GraphRelationSummary(
            IReadOnlyCollection<DependencyEdge> edges,
            Func<DependencyEdge, string> targetSelector,
            IReadOnlyDictionary<string, DependencyNode> nodesById)
        {
            if (edges.Count == 0)
                return L("common.none");
            const int maxItems = 5;
            var labels = edges
                .Take(maxItems)
                .Select(edge =>
                {
                    var id = targetSelector(edge);
                    return DependencyDisplayName(id, nodesById.Values);
                })
                .ToList();
            if (edges.Count > maxItems)
                labels.Add(AgentWorkbenchText.Format("graph.more", edges.Count - maxItems));
            return string.Join("、", labels);
        }

