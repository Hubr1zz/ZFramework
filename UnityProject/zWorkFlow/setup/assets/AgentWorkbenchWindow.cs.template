        private void DrawIntroduction()
        {
            EditorGUILayout.LabelField(L("intro.title"), EditorStyles.boldLabel);
            var nextTab = DrawUniformTabs(
                _introductionTab,
                new[] { L("intro.overview"), L("intro.quickstart") },
                TabButtonStyle(),
                TabButtonHeight);
            if (nextTab != _introductionTab)
            {
                _introductionTab = nextTab;
                _introductionScroll = Vector2.zero;
            }

            EditorGUILayout.Space(6);
            var fileName = _introductionTab == 0 ? "WORKFLOW_OVERVIEW.md" : "WORKFLOW_QUICKSTART.md";
            var path = ResolveHumanWorkflowDocument(fileName);
            if (string.IsNullOrWhiteSpace(path))
            {
                EditorGUILayout.HelpBox(AgentWorkbenchText.Format("intro.missing", fileName), MessageType.Warning);
                return;
            }

            try
            {
                var markdown = File.ReadAllText(path, Encoding.UTF8);
                using (new EditorGUILayout.VerticalScope(ReportPanelStyle(), GUILayout.ExpandHeight(true)))
                {
                    using (var scroll = new EditorGUILayout.ScrollViewScope(_introductionScroll))
                    {
                        _introductionScroll = scroll.scrollPosition;
                        DrawMarkdown(markdown, Mathf.Max(320f, position.width - 40f), Path.GetDirectoryName(path));
                    }
                }
            }
            catch (Exception exception)
            {
                EditorGUILayout.HelpBox(AgentWorkbenchText.Format("common.readFailed", exception.Message), MessageType.Warning);
            }
        }

        private string ResolveHumanWorkflowDocument(string fileName)
        {
            var packageDocument = Path.Combine(_projectRoot, "zWorkFlow", fileName);
            if (File.Exists(packageDocument))
                return packageDocument;

            // Legacy installs may still have copied human documents to the project root.
            var legacyProjectDocument = Path.Combine(_projectRoot, fileName);
            return File.Exists(legacyProjectDocument) ? legacyProjectDocument : null;
        }

