        [MainToolbarElement(ElementPath, defaultDockPosition = MainToolbarDockPosition.Middle, defaultDockIndex = 10)]
        private static MainToolbarElement Create()
        {
            var icon = EditorGUIUtility.IconContent("UnityEditor.ConsoleWindow").image as Texture2D;
            return new MainToolbarButton(new MainToolbarContent("Agent", icon, AgentWorkbenchText.Get("window.open")),
                AgentWorkbenchWindow.Open);
        }
    }
#elif UNITY_2021_2_OR_NEWER
    // Unity 2021.2-6.2 does not expose the public MainToolbarElement API used by newer
    // Unity 6 releases, so use the reflection bridge as a compatibility fallback.
    [InitializeOnLoad]
    internal static class AgentWorkbenchMainToolbar
    {
        private const string ButtonName = "AgentWorkflow.MainToolbarButton";
        private static readonly Type ToolbarType =
            typeof(UnityEditor.Editor).Assembly.GetType("UnityEditor.Toolbar");
        private static VisualElement _button;

        static AgentWorkbenchMainToolbar()
        {
            EditorApplication.update += Attach;
        }

        private static void Attach()
        {
            if (_button != null && _button.panel != null)
                return;
            if (ToolbarType == null)
                return;

            var toolbar = Resources.FindObjectsOfTypeAll(ToolbarType)
                .FirstOrDefault() as ScriptableObject;
            if (toolbar == null)
                return;

            var rootField = ToolbarType.GetField(
                "m_Root",
                BindingFlags.Instance | BindingFlags.NonPublic);
            var root = rootField?.GetValue(toolbar) as VisualElement;
            var leftZone = root?.Q<VisualElement>("ToolbarZoneLeftAlign");
            if (leftZone == null)
                return;

            var existing = leftZone.Q<VisualElement>(ButtonName);
            if (existing != null)
            {
                _button = existing;
                EditorApplication.update -= Attach;
                return;
            }

            var button = new Button(AgentWorkbenchWindow.Open)
            {
                name = ButtonName,
                text = "Agent",
                tooltip = AgentWorkbenchText.Get("window.open")
            };
            button.AddToClassList("unity-toolbar-button");
            button.style.minWidth = 44;
            button.style.maxWidth = 52;
            button.style.height = 22;
            leftZone.Add(button);
            _button = button;
            EditorApplication.update -= Attach;
        }
    }
#endif
}
#endif
