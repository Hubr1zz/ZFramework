        private void BeginSpecRename(SpecFile spec)
        {
            if (!TryLeaveRawEditor())
                return;
            _renamingSpec = spec;
            _specRenameBuffer = spec.Title;
            Repaint();
        }

        private void CancelSpecRename()
        {
            _renamingSpec = null;
            _specRenameBuffer = string.Empty;
            Repaint();
        }

        private void CommitSpecRename(SpecFile spec)
        {
            var nextTitle = _specRenameBuffer.Trim();
            if (string.IsNullOrWhiteSpace(nextTitle))
            {
                ShowNotification(new GUIContent(L("spec.renameEmpty")));
                return;
            }

            if (CurrentLanguageIsAuthority(spec.Path))
            {
                UpdateSpecDisplayTitle(
                    spec.Path,
                    Path.Combine(Path.GetDirectoryName(spec.Path) ?? _openSpecPath, "spec-review.json"),
                    nextTitle);
                ReplaceDependencyNodeLabel(spec.Capability, nextTitle);
            }
            else
            {
                SaveSpecTitle(spec.Capability, CurrentWorkbenchLanguage, nextTitle);
            }

            var capability = spec.Capability;
            CancelSpecRename();
            AssetDatabase.Refresh();
            ReloadOpenSpec();
            _selectedSpec = _specFiles.FirstOrDefault(item => item.Capability == capability);
        }

        private static void UpdateSpecDisplayTitle(string specPath, string reviewPath, string nextTitle)
        {
            var content = File.ReadAllText(specPath, Encoding.UTF8);
            var yamlTitle = "\"" + nextTitle.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
            content = new Regex(@"^title:\s*.*$", RegexOptions.Multiline)
                .Replace(content, "title: " + yamlTitle, 1);
            var headingMatch = Regex.Match(content, @"^#\s+(.+)$", RegexOptions.Multiline);
            if (headingMatch.Success)
            {
                var suffix = headingMatch.Groups[1].Value.EndsWith(" Specification", StringComparison.OrdinalIgnoreCase)
                    ? " Specification"
                    : string.Empty;
                content = content.Remove(headingMatch.Index, headingMatch.Length)
                    .Insert(headingMatch.Index, "# " + nextTitle + suffix);
            }
            File.WriteAllText(specPath, content, Encoding.UTF8);
            ReplaceJsonStringProperty(reviewPath, "title", nextTitle);
        }

        private static void ReplaceJsonStringProperty(string path, string property, string value)
        {
            if (!File.Exists(path))
                return;
            var json = File.ReadAllText(path, Encoding.UTF8);
            var encoded = EscapeJsonString(value);
            var pattern = $"(\"{Regex.Escape(property)}\"\\s*:\\s*\")((?:\\\\.|[^\"])*)\"";
            var updated = new Regex(pattern).Replace(
                json,
                match => match.Groups[1].Value + encoded + "\"",
                1);
            if (updated != json)
                File.WriteAllText(path, updated, Encoding.UTF8);
        }

        private void ReplaceDependencyNodeLabel(string capability, string value)
        {
            ReplaceDependencyNodeLabel(
                Path.Combine(_specMetadataPath, "dependencies.json"),
                capability,
                value);
        }

        private static void ReplaceDependencyNodeLabel(string path, string capability, string value)
        {
            if (!File.Exists(path))
                return;
            var json = File.ReadAllText(path, Encoding.UTF8);
            var pattern =
                $"(\\{{(?=[^{{}}]*\"id\"\\s*:\\s*\"{Regex.Escape(EscapeJsonString(capability))}\")[^{{}}]*\"label\"\\s*:\\s*\")((?:\\\\.|[^\"])*)\"";
            var updated = new Regex(pattern, RegexOptions.Singleline)
                .Replace(
                    json,
                    match => match.Groups[1].Value + EscapeJsonString(value) + "\"",
                    1);
            if (updated != json)
                File.WriteAllText(path, updated, Encoding.UTF8);
        }

        private static string EscapeJsonString(string value)
        {
            return value.Replace("\\", "\\\\")
                .Replace("\"", "\\\"")
                .Replace("\r", "\\r")
                .Replace("\n", "\\n")
                .Replace("\t", "\\t");
        }

