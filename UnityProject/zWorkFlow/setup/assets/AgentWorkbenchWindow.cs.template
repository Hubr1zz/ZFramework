                        else
                            BeginRawEdit(spec);
                    }
                }
                DrawTwoColumnFields(
                    new KeyValuePair<string, string>("Capability", spec.Capability),
                    new KeyValuePair<string, string>(L("spec.codeReadiness"), Or(node?.readiness, L("common.unregistered"))));
                DrawDesignSourceLinks(spec);

