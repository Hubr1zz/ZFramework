            $"change:{change?.Name}";

        private ChangeEntry ChangeForGraphNode(DependencyNode node)
        {
            if (node?.category != "change")
                return null;
            return _openChanges.FirstOrDefault(change => string.Equals(
                GraphChangeNodeId(change),
                node.id,
                StringComparison.OrdinalIgnoreCase));
        }

        private static string GraphFormalSpecReadiness(string readiness) =>
            (readiness ?? string.Empty).ToLowerInvariant() switch
            {
                "implemented" => "implemented",
                _ => "in-progress"
            };

        private static string GraphChangeReadiness(ChangeEntry change)
        {
            if (change == null)
                return "in-progress";
            if (string.Equals(change.SyncValidation?.status, "conflict", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(change.SpecSyncStatus, "blocked-by-conflict", StringComparison.OrdinalIgnoreCase) ||
                (change.Readiness ?? string.Empty).StartsWith("blocked-by-", StringComparison.OrdinalIgnoreCase) ||
                (change.CodeReadiness ?? string.Empty).StartsWith("blocked-by-", StringComparison.OrdinalIgnoreCase) ||
                change.Dependencies.Any(edge => edge.blocksImplementation &&
                                                !string.Equals(edge.status, "resolved", StringComparison.OrdinalIgnoreCase)))
                return "blocked";
            if (!IsAppliedChangeProvider(change))
                return "in-progress";
            return string.Equals(change.SpecSyncStatus, "synced", StringComparison.OrdinalIgnoreCase)
                ? "implemented"
                : "pending-sync";
        }

