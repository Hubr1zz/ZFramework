                {
                    $"{L("common.all")}（{_specFiles.Count}）",
                    $"{L("spec.architecture")}（{_specFiles.Count(spec => spec.Category == "system")}）",
                    $"{L("spec.feature")}（{_specFiles.Count(spec => spec.Category == "feature")}）",
                    $"{L("spec.rule")}（{_specFiles.Count(spec => spec.Category == "game-rule")}）"
