        }

        private SpecFolderConfig SelectedCustomFolder()
        {
            var folders = _config.specFolders ?? Array.Empty<SpecFolderConfig>();
            var index = _specFolderFilterIndex - 2;
            return index >= 0 && index < folders.Length ? folders[index] : null;
        }

        private void DrawEmptyFormalFolderPanel(SpecFolderConfig folder)
        {
            using (new EditorGUILayout.VerticalScope(ReportSectionStyle()))
            {
                EditorGUILayout.LabelField(folder.name, ReportTitleStyle());
                EditorGUILayout.HelpBox(L("spec.emptyFolder"), MessageType.Info);
                if (GUILayout.Button(L("spec.deleteFolder"), GUILayout.Width(136)))
                {
                    var message = AgentWorkbenchText.Format("spec.deleteFolderConfirm", folder.name);
                    if (EditorUtility.DisplayDialog(L("spec.deleteFolder"), message, L("spec.deleteFolder"), L("spec.cancel")))
                        DeleteFormalFolder(folder.id);
                }
            }
        }

        private bool FolderHasAnyFormalEntry(string folderId)
        {
            var capabilities = new HashSet<string>(
                (_config.specFolderAssignments ?? Array.Empty<SpecFolderAssignment>())
                .Where(item => item.folderId == folderId)
                .Select(item => item.capability),
                StringComparer.OrdinalIgnoreCase);
            return _specFiles.Any(spec => capabilities.Contains(spec.Capability)) ||
                   _openChanges.Any(change => capabilities.Contains(change.Capability));
        }

        private void DeleteFormalFolder(string folderId)
        {
            _config.specFolders = (_config.specFolders ?? Array.Empty<SpecFolderConfig>())
                .Where(folder => folder.id != folderId).ToArray();
            _config.specFolderAssignments = (_config.specFolderAssignments ?? Array.Empty<SpecFolderAssignment>())
                .Where(item => item.folderId != folderId).ToArray();
            _specFolderFilterIndex = 0;
            _changeFolderFilterIndex = 0;
            SaveWorkbenchConfig();
        }

        private void DrawSpecFolderControls()
        {
            var folders = _config.specFolders ?? Array.Empty<SpecFolderConfig>();
            var labels = new List<string> { L("spec.allFolders"), L("spec.noFolder") };
            labels.AddRange(folders.Select(folder => folder.name));
            _specFolderFilterIndex = Mathf.Clamp(_specFolderFilterIndex, 0, labels.Count - 1);
            using (new EditorGUILayout.HorizontalScope())
            {
                EditorGUILayout.LabelField(L("spec.folder"), GUILayout.Width(48));
                var nextFolderFilter = EditorGUILayout.Popup(_specFolderFilterIndex, labels.ToArray(), GUILayout.Width(180));
                if (nextFolderFilter != _specFolderFilterIndex && TryLeaveRawEditor())
                    _specFolderFilterIndex = nextFolderFilter;
                GUILayout.Space(12);
                EditorGUILayout.LabelField(L("spec.newFolder"), GUILayout.Width(76));
                _newSpecFolderName = EditorGUILayout.TextField(_newSpecFolderName, GUILayout.Width(180));
                GUI.enabled = !string.IsNullOrWhiteSpace(_newSpecFolderName);
                if (GUILayout.Button(L("spec.create"), GUILayout.Width(58)))
                    CreateSpecFolder(_newSpecFolderName);
                GUI.enabled = true;
                GUILayout.FlexibleSpace();
            }
        }

        private bool SpecMatchesFolderFilter(SpecFile spec)
        {
            if (_specFolderFilterIndex == 0)
                return true;
            var folderId = FolderIdFor(spec.Capability);
            if (_specFolderFilterIndex == 1)
                return string.IsNullOrWhiteSpace(folderId);
            var folders = _config.specFolders ?? Array.Empty<SpecFolderConfig>();
            var folderIndex = _specFolderFilterIndex - 2;
            return folderIndex >= 0 && folderIndex < folders.Length && folders[folderIndex].id == folderId;
        }

        private void DrawSpecListItem(SpecFile spec)
        {
            const float rowHeight = 29f;
            if (ReferenceEquals(_renamingSpec, spec))
            {
                using (new EditorGUILayout.HorizontalScope(GUILayout.Height(rowHeight)))
                {
                    _specRenameBuffer = EditorGUILayout.TextField(_specRenameBuffer, GUILayout.Height(rowHeight - 2));
                    if (GUILayout.Button("✓", GUILayout.Width(28), GUILayout.Height(rowHeight - 2)))
                        CommitSpecRename(spec);
                    if (GUILayout.Button("×", GUILayout.Width(28), GUILayout.Height(rowHeight - 2)))
                        CancelSpecRename();
                }
                return;
            }

            var rowRect = GUILayoutUtility.GetRect(1, rowHeight, GUILayout.ExpandWidth(true));
            const float folderButtonWidth = 28f;
            var selectRect = new Rect(rowRect.x, rowRect.y, rowRect.width - folderButtonWidth - 2f, rowRect.height);
            var folderRect = new Rect(selectRect.xMax + 2f, rowRect.y, folderButtonWidth, rowRect.height);
            var selected = ReferenceEquals(spec, _selectedSpec);
            var style = SpecListItemStyle(selected);
            if (Event.current.type == EventType.ContextClick && selectRect.Contains(Event.current.mousePosition))
            {
                var menu = new GenericMenu();
                menu.AddItem(new GUIContent(L("spec.rename")), false, () => BeginSpecRename(spec));
                menu.ShowAsContext();
                Event.current.Use();
            }
            else if (Event.current.type == EventType.MouseDown &&
                     Event.current.button == 0 &&
                     Event.current.clickCount == 2 &&
                     selectRect.Contains(Event.current.mousePosition))
            {
                BeginSpecRename(spec);
                Event.current.Use();
            }
            if (GUI.Button(selectRect, GUIContent.none, style) && TryLeaveRawEditor())
            {
                _selectedSpec = spec;
                _specDetailScroll = Vector2.zero;
            }

            var categoryWidth = 96f;
            var nameRect = new Rect(selectRect.x + 10, selectRect.y, selectRect.width - categoryWidth - 18, selectRect.height);
            var categoryRect = new Rect(selectRect.xMax - categoryWidth - 6, selectRect.y, categoryWidth, selectRect.height);
            GUI.Label(nameRect, new GUIContent(spec.Title, FolderNameFor(spec.Capability)), SpecListNameStyle());
            GUI.Label(categoryRect, CategoryLabel(spec.Category), CategoryStyle(spec.Category));
            if (GUI.Button(folderRect, FolderAssignmentContent(spec.Capability), FolderListButtonStyle()))
                ShowFolderAssignmentMenu(spec.Capability);
        }

