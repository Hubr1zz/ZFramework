        private void DrawPairedFormalFeatureLink(SpecFile ruleSpec)
        {
            var pairedFeature = FindPairedFormalSpec(ruleSpec, "feature");
            if (pairedFeature == null)
            {
                EditorGUILayout.HelpBox(L("import.pairedFeatureMissing"), MessageType.Warning);
                return;
            }
            if (GUILayout.Button(
                    AgentWorkbenchText.Format("import.openPairedFeature", pairedFeature.Title),
                    ReportActionButtonStyle(),
                    GUILayout.ExpandWidth(true),
                    GUILayout.Height(30)))
                SelectDocument(pairedFeature.Path);
        }

        private SpecFile FindPairedFormalSpec(SpecFile spec, string category)
        {
            if (spec == null)
                return null;
            var explicitCapability = category == "feature"
                ? spec.PairedFeatureCapability
                : spec.PairedRuleCapability;
            if (!string.IsNullOrWhiteSpace(explicitCapability))
            {
                var explicitMatch = _specFiles.FirstOrDefault(item =>
                    string.Equals(item.Capability, explicitCapability, StringComparison.OrdinalIgnoreCase));
                if (explicitMatch != null)
                    return explicitMatch;
            }
            var pairedCapability = category == "feature"
                ? _dependencyEdges.FirstOrDefault(edge =>
                    string.Equals(edge.from, spec.Capability, StringComparison.OrdinalIgnoreCase) &&
                    _specFiles.Any(item => item.Category == "feature" && string.Equals(
                        item.Capability,
                        edge.to,
                        StringComparison.OrdinalIgnoreCase)))?.to
                : _dependencyEdges.FirstOrDefault(edge =>
                    string.Equals(edge.to, spec.Capability, StringComparison.OrdinalIgnoreCase) &&
                    _specFiles.Any(item => item.Category == "game-rule" && string.Equals(
                        item.Capability,
                        edge.from,
                        StringComparison.OrdinalIgnoreCase)))?.from;
            return _specFiles.FirstOrDefault(item =>
                item.Category == category &&
                string.Equals(item.Capability, pairedCapability, StringComparison.OrdinalIgnoreCase));
        }

        private void DrawDesignSourceLinks(SpecFile spec)
        {
            if (spec == null || spec.Category != "game-rule")
                return;

            var paths = ResolveDesignSourcePaths(spec.SourceReferences).ToList();
            if (paths.Count == 0)
                return;
            using (new EditorGUILayout.HorizontalScope())
            {
                EditorGUILayout.LabelField(L("spec.designSources"), GUILayout.Width(96));
                foreach (var path in paths.Take(3))
                {
                    var label = paths.Count == 1 ? L("spec.openDesignSource") : Path.GetFileNameWithoutExtension(path);
                    if (GUILayout.Button(new GUIContent(label, path), ReportActionButtonStyle(), GUILayout.MaxWidth(190), GUILayout.Height(26)))
                        OpenMarkdownDocument(path);
                }
                GUILayout.FlexibleSpace();
            }
        }

        private IEnumerable<string> ResolveDesignSourcePaths(IEnumerable<string> references)
        {
            var availableSources = _designDocumentSources
                .Where(source => source != null && !string.IsNullOrWhiteSpace(source.id) &&
                                 !string.IsNullOrWhiteSpace(source.path) && Directory.Exists(source.path))
                .ToList();
            if (availableSources.Count == 0)
                yield break;

            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var reference in references ?? Array.Empty<string>())
            {
                var match = DesignSourceReferenceRegex.Match(reference ?? string.Empty);
                if (!match.Success)
                    continue;
                var relative = match.Groups["path"].Value.Trim().Trim('`', '"', '\'').Replace('/', Path.DirectorySeparatorChar);
                var sourceId = match.Groups["sourceId"].Value;
                var candidateSources = string.IsNullOrWhiteSpace(sourceId)
                    ? availableSources
                    : availableSources.Where(source => string.Equals(source.id, sourceId, StringComparison.OrdinalIgnoreCase));
                foreach (var source in candidateSources)
                {
                    string root;
                    string candidate;
                    try
                    {
                        root = Path.GetFullPath(source.path).TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
                        candidate = Path.GetFullPath(Path.IsPathRooted(relative)
                            ? relative
                            : Path.Combine(source.path, relative));
                    }
                    catch
                    {
                        continue;
                    }
                    if (!candidate.StartsWith(root, StringComparison.OrdinalIgnoreCase) ||
                        !File.Exists(candidate) || !seen.Add(candidate))
                        continue;
                    yield return candidate;
                }
            }
        }

        private bool TryResolveDesignSourceReference(
            string reference,
            out string resolvedPath,
            out int line)
        {
            resolvedPath = string.Empty;
            line = 0;
            var match = DesignSourceReferenceRegex.Match(reference ?? string.Empty);
            if (!match.Success)
                return false;
            int.TryParse(match.Groups["line"].Value, out line);
            var sourceId = match.Groups["sourceId"].Value;
            var relative = match.Groups["path"].Value.Trim().Trim('`', '"', '\'')
                .Replace('/', Path.DirectorySeparatorChar);
            foreach (var source in _designDocumentSources.Where(source =>
                         source != null &&
                         !string.IsNullOrWhiteSpace(source.path) &&
                         Directory.Exists(source.path) &&
                         (string.IsNullOrWhiteSpace(sourceId) ||
                          string.Equals(source.id, sourceId, StringComparison.OrdinalIgnoreCase))))
            {
                try
                {
                    var root = Path.GetFullPath(source.path).TrimEnd(Path.DirectorySeparatorChar) +
                               Path.DirectorySeparatorChar;
                    var candidate = Path.GetFullPath(Path.IsPathRooted(relative)
                        ? relative
                        : Path.Combine(source.path, relative));
                    if (!candidate.StartsWith(root, StringComparison.OrdinalIgnoreCase) || !File.Exists(candidate))
                        continue;
                    resolvedPath = candidate;
                    return true;
                }
                catch
                {
                    // Invalid or inaccessible source entries are ignored.
                }
            }
            return false;
        }

        private void DrawSpecFolderAssignment(SpecFile spec)
        {
            var folders = _config.specFolders ?? Array.Empty<SpecFolderConfig>();
            var labels = new List<string> { L("spec.noFolder") };
            labels.AddRange(folders.Select(folder => folder.name));
            var currentId = FolderIdFor(spec.Capability);
            var currentIndex = string.IsNullOrWhiteSpace(currentId)
                ? 0
                : Array.FindIndex(folders, folder => folder.id == currentId) + 1;
            currentIndex = Mathf.Max(0, currentIndex);
            var nextIndex = EditorGUILayout.Popup(L("spec.folder"), currentIndex, labels.ToArray());
            if (nextIndex != currentIndex)
                AssignSpecFolder(spec.Capability, nextIndex == 0 ? null : folders[nextIndex - 1].id);
        }

        private void BeginRawEdit(SpecFile spec)
        {
            var canonicalContent = File.Exists(spec.Path)
                ? File.ReadAllText(spec.Path, Encoding.UTF8)
                : spec.Content;
            if (!CanEditCanonicalInCurrentLanguage(spec.Path, canonicalContent))
                return;
            if (_rawEditingSpec != null && !ReferenceEquals(_rawEditingSpec, spec) && !TryLeaveRawEditor())
                return;
            _rawEditingSpec = spec;
            _rawSpecOriginal = canonicalContent;
            _rawSpecBuffer = _rawSpecOriginal;
            _rawSpecScroll = Vector2.zero;
            _selectedSpec = spec;
            Repaint();
        }

        private void DrawRawSpecEditor()
        {
            using (new EditorGUILayout.HorizontalScope())
            {
                GUI.enabled = HasUnsavedRawChanges();
                if (GUILayout.Button(L("spec.save"), GUILayout.Width(72)))
                    SaveRawSpec();
                GUI.enabled = true;
                if (GUILayout.Button(L("spec.discard"), GUILayout.Width(92)))
                {
                    DiscardRawSpec();
                    GUIUtility.ExitGUI();
                }
                GUILayout.FlexibleSpace();
            }

            _rawSpecScroll = BeginVerticalScrollView(_rawSpecScroll, GUILayout.ExpandHeight(true));
            var style = new GUIStyle(EditorStyles.textArea)
            {
                wordWrap = true,
                richText = false
            };
            _rawSpecBuffer = EditorGUILayout.TextArea(
                _rawSpecBuffer,
                style,
                GUILayout.ExpandWidth(true),
                GUILayout.ExpandHeight(true),
                GUILayout.MinHeight(320));
            EditorGUILayout.EndScrollView();
        }

        private bool HasUnsavedRawChanges()
        {
            return _rawEditingSpec != null &&
                   !string.Equals(_rawSpecBuffer, _rawSpecOriginal, StringComparison.Ordinal);
        }

        private bool TryLeaveRawEditor()
        {
            if (_rawEditingSpec != null)
            {
                if (!HasUnsavedRawChanges())
                {
                    DiscardRawSpec();
                }
                else
                {
                    var choice = EditorUtility.DisplayDialogComplex(
                        L("spec.unsavedTitle"),
                        L("spec.unsavedMessage"),
                        L("spec.save"),
                        L("spec.discard"),
                        L("spec.cancel"));
                    if (choice == 0)
                        SaveRawSpec();
                    else if (choice == 1)
                        DiscardRawSpec();
                    else
                        return false;
                }
            }

            return TryLeaveMarkdownEditor();
        }

        private bool TryLeaveMarkdownEditor()
        {
            if (string.IsNullOrWhiteSpace(_editingMarkdownPath))
                return true;
            if (!HasUnsavedMarkdownChanges())
            {
                DiscardMarkdownEdit();
                return true;
            }

            var choice = EditorUtility.DisplayDialogComplex(
                L("spec.unsavedTitle"),
                L("spec.unsavedMessage"),
                L("spec.save"),
                L("spec.discard"),
                L("spec.cancel"));
            if (choice == 0)
            {
                SaveMarkdownEdit();
                return true;
            }
            if (choice == 1)
            {
                DiscardMarkdownEdit();
                return true;
            }
            return false;
        }

        private void BeginMarkdownEdit(string label, string path, string content, params string[] mirrorPaths)
        {
            if (string.IsNullOrWhiteSpace(path))
                return;
            var canonicalContent = File.Exists(path) ? File.ReadAllText(path, Encoding.UTF8) : content;
            if (!CanEditCanonicalInCurrentLanguage(path, canonicalContent))
                return;
            if (!string.Equals(_editingMarkdownPath, path, StringComparison.OrdinalIgnoreCase) &&
                !TryLeaveRawEditor())
                return;
            _editingMarkdownPath = path;
            _editingMarkdownMirrorPaths = mirrorPaths?
                .Where(item => !string.IsNullOrWhiteSpace(item))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray() ?? Array.Empty<string>();
            _editingMarkdownLabel = label;
            _editingMarkdownOriginal = File.Exists(path)
                ? File.ReadAllText(path, Encoding.UTF8)
                : Or(content, string.Empty);
            _editingMarkdownBuffer = _editingMarkdownOriginal;
            Repaint();
        }

        private bool HasUnsavedMarkdownChanges() =>
            !string.IsNullOrWhiteSpace(_editingMarkdownPath) &&
            !string.Equals(_editingMarkdownBuffer, _editingMarkdownOriginal, StringComparison.Ordinal);

        private void DrawMarkdownEditor(string path, float width)
        {
            using (new EditorGUILayout.HorizontalScope())
            {
                EditorGUILayout.LabelField(_editingMarkdownLabel, ReportMiniHeaderStyle());
                GUILayout.FlexibleSpace();
                GUI.enabled = HasUnsavedMarkdownChanges();
                if (GUILayout.Button(L("spec.save"), ReportActionButtonStyle(), GUILayout.Width(72), GUILayout.Height(28)))
                    SaveMarkdownEdit();
                GUI.enabled = true;
                if (GUILayout.Button(L("spec.discard"), ReportActionButtonStyle(), GUILayout.Width(92), GUILayout.Height(28)))
                {
                    DiscardMarkdownEdit(true);
                    GUIUtility.ExitGUI();
                }
            }

            var style = new GUIStyle(EditorStyles.textArea) { wordWrap = true, richText = false };
            var editorWidth = Mathf.Max(280f, width - 16f);
            var editorHeight = Mathf.Max(
                300f,
                style.CalcHeight(new GUIContent(_editingMarkdownBuffer ?? string.Empty), editorWidth) + 16f);
            _editingMarkdownBuffer = EditorGUILayout.TextArea(
                _editingMarkdownBuffer,
                style,
                GUILayout.ExpandWidth(true),
                GUILayout.Height(editorHeight));
        }

        private void DrawEditableMarkdown(
            string label,
            string path,
            string content,
            float width,
            params string[] mirrorPaths)
        {
            var editing = string.Equals(_editingMarkdownPath, path, StringComparison.OrdinalIgnoreCase);
            if (!editing)
            {
                using (new EditorGUILayout.HorizontalScope())
                {
                    GUILayout.FlexibleSpace();
                    if (GUILayout.Button(L("spec.rawText"), ReportActionButtonStyle(), GUILayout.Width(112), GUILayout.Height(28)))
                        BeginMarkdownEdit(label, path, content, mirrorPaths);
                }
            }

            if (string.Equals(_editingMarkdownPath, path, StringComparison.OrdinalIgnoreCase))
                DrawMarkdownEditor(path, width);
            else
                DrawLocalizedMarkdown(path, content, width);
        }

        private void SaveMarkdownEdit()
        {
            if (string.IsNullOrWhiteSpace(_editingMarkdownPath))
                return;
            var paths = new[] { _editingMarkdownPath }
                .Concat(_editingMarkdownMirrorPaths ?? Array.Empty<string>())
                .Where(item => !string.IsNullOrWhiteSpace(item))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();
            foreach (var path in paths)
            {
                var directory = Path.GetDirectoryName(path);
                if (!string.IsNullOrWhiteSpace(directory) && Directory.Exists(directory))
                    File.WriteAllText(path, _editingMarkdownBuffer, Encoding.UTF8);
            }
            DiscardMarkdownEdit();
            AssetDatabase.Refresh();
            ReloadOpenSpec();
            ReloadDesignImports();
        }

        private void DiscardMarkdownEdit(bool reloadSources = false)
        {
            _editingMarkdownBuffer = _editingMarkdownOriginal;
            ReleaseTextEditorFocus();
            _editingMarkdownPath = null;
            _editingMarkdownMirrorPaths = Array.Empty<string>();
            _editingMarkdownLabel = string.Empty;
            _editingMarkdownBuffer = string.Empty;
            _editingMarkdownOriginal = string.Empty;
            if (reloadSources)
            {
                ReloadOpenSpec();
                ReloadDesignImports();
            }
            Repaint();
        }

        private void SaveRawSpec()
        {
            if (_rawEditingSpec == null)
                return;
            var capability = _rawEditingSpec.Capability;
            File.WriteAllText(_rawEditingSpec.Path, _rawSpecBuffer, Encoding.UTF8);
            _rawSpecOriginal = _rawSpecBuffer;
            _rawEditingSpec = null;
            AssetDatabase.Refresh();
            ReloadOpenSpec();
            _selectedSpec = _specFiles.FirstOrDefault(spec => spec.Capability == capability);
        }

        private void DiscardRawSpec()
        {
            _rawSpecBuffer = _rawSpecOriginal;
            ReleaseTextEditorFocus();
            _rawEditingSpec = null;
            _rawSpecBuffer = string.Empty;
            _rawSpecOriginal = string.Empty;
            _rawSpecScroll = Vector2.zero;
            Repaint();
        }

        private static void ReleaseTextEditorFocus()
        {
            GUI.FocusControl(null);
            GUIUtility.keyboardControl = 0;
            EditorGUIUtility.editingTextField = false;
        }

        private void CreateSpecFolder(string name)
        {
            name = name.Trim();
            var slug = Regex.Replace(name.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
            if (string.IsNullOrWhiteSpace(slug))
                slug = Guid.NewGuid().ToString("N").Substring(0, 8);
            var id = "custom-" + slug;
            var suffix = 2;
            var folders = (_config.specFolders ?? Array.Empty<SpecFolderConfig>()).ToList();
            while (folders.Any(folder => folder.id == id))
                id = $"custom-{slug}-{suffix++}";
            folders.Add(new SpecFolderConfig { id = id, name = name });
            _config.specFolders = folders.ToArray();
            _newSpecFolderName = string.Empty;
            _specFolderFilterIndex = 0;
            SaveWorkbenchConfig();
        }

        private void AssignSpecFolder(string capability, string folderId)
        {
            var assignments = (_config.specFolderAssignments ?? Array.Empty<SpecFolderAssignment>())
                .Where(item => !string.Equals(item.capability, capability, StringComparison.OrdinalIgnoreCase)).ToList();
            if (!string.IsNullOrWhiteSpace(folderId))
                assignments.Add(new SpecFolderAssignment { capability = capability, folderId = folderId });
            _config.specFolderAssignments = assignments.ToArray();
            SaveWorkbenchConfig();
        }

        private GUIContent FolderAssignmentContent(string capability)
        {
            var folderName = FolderNameFor(capability);
            var tooltip = string.IsNullOrWhiteSpace(folderName)
                ? L("spec.assignFolder")
                : AgentWorkbenchText.Format("spec.currentFolder", folderName);
            return new GUIContent(EditorGUIUtility.IconContent("Folder Icon").image, tooltip);
        }

        private void ShowFolderAssignmentMenu(string capability)
        {
            if (string.IsNullOrWhiteSpace(capability))
                return;
            var currentId = FolderIdFor(capability);
            var menu = new GenericMenu();
            menu.AddItem(
                new GUIContent(L("spec.noFolder")),
                string.IsNullOrWhiteSpace(currentId),
                () => AssignSpecFolder(capability, null));
            var folders = _config.specFolders ?? Array.Empty<SpecFolderConfig>();
            if (folders.Length > 0)
                menu.AddSeparator(string.Empty);
            foreach (var folder in folders)
            {
                var captured = folder;
                menu.AddItem(
                    new GUIContent(captured.name),
                    string.Equals(currentId, captured.id, StringComparison.OrdinalIgnoreCase),
                    () => AssignSpecFolder(capability, captured.id));
            }
            menu.ShowAsContext();
        }

        private string FolderIdFor(string capability) =>
            (_config.specFolderAssignments ?? Array.Empty<SpecFolderAssignment>())
            .FirstOrDefault(item => string.Equals(item.capability, capability, StringComparison.OrdinalIgnoreCase))?.folderId;

        private string FolderNameFor(string capability)
        {
            var id = FolderIdFor(capability);
            return (_config.specFolders ?? Array.Empty<SpecFolderConfig>())
                .FirstOrDefault(folder => folder.id == id)?.name;
        }

        private IEnumerable<SpecFile> SpecsForCategory(SpecCategoryTab categoryTab)
        {
            var category = categoryTab switch
            {
                SpecCategoryTab.System => "system",
                SpecCategoryTab.Feature => "feature",
                SpecCategoryTab.GameRule => "game-rule",
                _ => string.Empty
            };
            return string.IsNullOrEmpty(category)
                ? _specFiles
                : _specFiles.Where(spec => spec.Category == category);
        }

        private void DrawSpecDependencyTree(string capability, int depth, HashSet<string> visited)
        {
            if (!visited.Add(capability))
            {
                EditorGUILayout.LabelField(
                    $"{new string(' ', depth * 2)}↳ {L("spec.cycle")}：{DependencyDisplayName(capability)}",
                    ReportMutedStyle());
                return;
            }

            var edges = _dependencyEdges.Where(edge =>
                string.Equals(edge.from, capability, StringComparison.OrdinalIgnoreCase)).ToList();
            if (depth == 0 && edges.Count == 0)
            {
                EditorGUILayout.LabelField(L("spec.dependenciesNone"), ReportMutedStyle());
                visited.Remove(capability);
                return;
            }

            foreach (var edge in edges)
            {
                var target = _dependencyNodes.FirstOrDefault(node =>
                    string.Equals(node.id, edge.to, StringComparison.OrdinalIgnoreCase));
                var missing = target == null && edge.status != "resolved";
                var marker = missing ? "⚠" : edge.blocksImplementation && edge.status != "resolved" ? "⛔" : "↳";
                var indent = new string(' ', depth * 4);
                EditorGUILayout.LabelField(
                    $"{indent}{marker} {DependencyDisplayName(edge.to)} [{CategoryLabel(target?.category)}] · {Or(edge.reason, L("common.noDetails"))}",
                    ReportMiniWrapStyle());
                if (target != null)
                    DrawSpecDependencyTree(target.id, depth + 1, visited);
            }

            visited.Remove(capability);
        }

        private string DependencyDisplayName(
            string capability,
            IEnumerable<DependencyNode> nodes = null)
        {
            var spec = _specFiles.FirstOrDefault(item =>
                string.Equals(item.Capability, capability, StringComparison.OrdinalIgnoreCase));
            if (spec != null)
                return spec.Title;
            var draft = FindDraftSpec(capability);
            if (draft != null)
                return ResolveSpecDisplayTitle(draft.Capability, draft.SpecPath, draft.CanonicalTitle);
            var configured = ConfiguredSpecTitle(capability, CurrentWorkbenchLanguage);
            if (!string.IsNullOrWhiteSpace(configured))
                return configured;
            var node = (nodes ?? _dependencyNodes).FirstOrDefault(item =>
                string.Equals(item.id, capability, StringComparison.OrdinalIgnoreCase));
            return Or(node?.label, capability);
        }

        private void DrawGap(SpecGap gap)
        {
            var hard = gap.blocksImplementation && gap.status != "resolved";
            DrawReadableGap(gap);

            if (gap.status == "resolved")
                return;

            if (gap.status == "accepted")
            {
                EditorGUILayout.LabelField($"{L("gap.acceptedBy")}：{Or(gap.acceptedBy, "-")}  {L("gap.time")}：{Or(gap.acceptedAt, "-")}",
                    EditorStyles.miniLabel);
                if (hard)
                    EditorGUILayout.HelpBox(L("gap.hardHint"),
                        MessageType.Warning);
                return;
            }

            EditorGUILayout.LabelField(L("gap.acceptTitle"), EditorStyles.miniBoldLabel);
            _gapRationale = EditorGUILayout.TextField(L("gap.rationale"), _gapRationale);
            _gapDeliveryBoundary = EditorGUILayout.TextField(L("gap.boundary"), _gapDeliveryBoundary);
            _gapImplementationImpact = EditorGUILayout.TextField(L("gap.implementation"), _gapImplementationImpact);
            GUI.enabled = !string.IsNullOrWhiteSpace(_gapRationale) &&
                          !string.IsNullOrWhiteSpace(_gapDeliveryBoundary) &&
                          !string.IsNullOrWhiteSpace(_gapImplementationImpact);
            if (GUILayout.Button(hard ? L("gap.recordHard") : L("gap.acceptDeferred")))
                AcceptGap(gap);
            GUI.enabled = true;
        }

        private void DrawDependencyGraph()
        {
            EditorGUILayout.Space(8);
            using (new EditorGUILayout.HorizontalScope())
            {
                EditorGUILayout.LabelField(L("graph.title"), EditorStyles.boldLabel);
                GUILayout.Label($"● {L("spec.architecture")}", GraphLegendStyle(new Color(0.27f, 0.55f, 0.95f)), GUILayout.Width(92));
                GUILayout.Label("● Feature", GraphLegendStyle(new Color(0.24f, 0.72f, 0.55f)), GUILayout.Width(82));
                GUILayout.Label($"● {L("graph.changeNode")}", GraphLegendStyle(new Color(0.68f, 0.38f, 0.82f)), GUILayout.Width(88));
                GUILayout.FlexibleSpace();
                if (GUILayout.Button(L("graph.reset"), GUILayout.Width(88)))
                    ResetDependencyGraphView();
            }

            var specsByCapability = _specFiles.ToDictionary(
                spec => spec.Capability,
                StringComparer.OrdinalIgnoreCase);
            var formalNodes = _dependencyNodes
                .Where(node => NormalizeCategory(node.category) is "system" or "feature")
                .Where(node => specsByCapability.ContainsKey(node.id))
                .Select(node => new DependencyNode
                {
                    id = node.id,
                    label = node.label,
                    category = node.category,
                    readiness = GraphFormalSpecReadiness(node.readiness),
                    specPath = node.specPath
                })
                .ToList();
            var pendingTargetNodes = _openChanges
                .Where(change => !string.Equals(change.SpecSyncStatus, "synced", StringComparison.OrdinalIgnoreCase))
                .SelectMany(change => change.SyncTargets)
                .Where(target => NormalizeCategory(target.category) is "system" or "feature")
                .Select(target => new DependencyNode
                {
                    id = target.capability,
                    label = Or(target.title, target.capability),
                    category = target.category,
                    readiness = "delta-pending",
                    specPath = target.targetSpecPath
                });
            var changeNodes = _showDependencyGraphChanges
                ? _openChanges.Select(change => new DependencyNode
                {
                    id = GraphChangeNodeId(change),
                    label = change.Title,
                    category = "change",
                    readiness = GraphChangeReadiness(change),
                    specPath = change.Path
                })
                : Enumerable.Empty<DependencyNode>();
            var graphNodes = formalNodes
                .Concat(pendingTargetNodes)
                .Concat(changeNodes)
                .GroupBy(node => node.id, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.OrderBy(node => node.readiness == "delta-pending" ? 1 : 0).First())
                .OrderBy(node => node.category)
                .ThenBy(node => DependencyDisplayName(node.id, new[] { node }))
                .ToList();
            if (graphNodes.Count == 0)
            {
                EditorGUILayout.HelpBox(L("graph.empty"), MessageType.Info);
                return;
            }

            var graphNodeIds = new HashSet<string>(
                graphNodes.Select(node => node.id),
                StringComparer.OrdinalIgnoreCase);
            var pendingEdges = _openChanges
                .Where(change => !string.Equals(change.SpecSyncStatus, "synced", StringComparison.OrdinalIgnoreCase))
                .SelectMany(change => change.Dependencies);
            var graphEdges = _dependencyEdges
                .Concat(pendingEdges)
                .Concat(_showDependencyGraphChanges ? ChangeGraphEdges() : Enumerable.Empty<DependencyEdge>())
                .GroupBy(edge => edge.id, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .Where(edge => graphNodeIds.Contains(edge.from) && graphNodeIds.Contains(edge.to))
                .ToList();
            if (string.IsNullOrEmpty(_selectedDependencyGraphNode) ||
                graphNodes.All(node => !string.Equals(
                    node.id,
                    _selectedDependencyGraphNode,
                    StringComparison.OrdinalIgnoreCase)))
                _selectedDependencyGraphNode = graphNodes.First().id;

            var canvasHeight = Mathf.Clamp((position.height - 340f) * 1.2f, 300f, 492f);
            var canvasRect = GUILayoutUtility.GetRect(
                100f,
                canvasHeight,
                GUILayout.ExpandWidth(true),
                GUILayout.Height(canvasHeight));
            EnsureDependencyGraphLayout(graphNodes, graphEdges);
            DrawDependencyGraphCanvas(canvasRect, graphNodes, graphEdges);
            EditorGUILayout.LabelField(
                L("graph.help"),
                ReportMiniWrapStyle());
            DrawDependencyGraphInfo(graphNodes, graphEdges, specsByCapability, 215f);
        }

        private void DrawDependencyGraphCanvas(
            Rect canvasRect,
            IReadOnlyCollection<DependencyNode> nodes,
            IReadOnlyCollection<DependencyEdge> edges)
        {
            GUI.BeginGroup(canvasRect);
            var localCanvas = new Rect(0f, 0f, canvasRect.width, canvasRect.height);
            EditorGUI.DrawRect(localCanvas, AgentWorkbenchTheme.IsDarkMode
                ? new Color(0.10f, 0.11f, 0.13f)
                : new Color(0.88f, 0.89f, 0.91f));
            DrawDependencyGraphGrid(localCanvas);

            var changeToggleRect = new Rect(10f, 10f, 132f, 24f);
            var nodeRects = nodes.ToDictionary(
                node => node.id,
                node => DependencyGraphNodeRect(localCanvas, node.id),
                StringComparer.OrdinalIgnoreCase);
            HandleDependencyGraphInput(localCanvas, nodeRects, changeToggleRect);

            Handles.BeginGUI();
            foreach (var edge in edges)
            {
                if (!nodeRects.TryGetValue(edge.from, out var fromRect) ||
                    !nodeRects.TryGetValue(edge.to, out var toRect))
                    continue;
                DrawDependencyGraphEdge(
                    DependencyGraphMainNodeRect(fromRect),
                    DependencyGraphMainNodeRect(toRect),
                    edge);
            }
            Handles.EndGUI();

            foreach (var node in nodes)
                DrawDependencyGraphNode(
                    nodeRects[node.id],
                    node,
                    string.Equals(node.id, _selectedDependencyGraphNode, StringComparison.OrdinalIgnoreCase),
                    PendingDeltaChanges(node.id).Count);
            if (GUI.Button(
                    changeToggleRect,
                    L(_showDependencyGraphChanges ? "graph.hideChanges" : "graph.showChanges"),
                    EditorStyles.miniButton))
            {
                _showDependencyGraphChanges = !_showDependencyGraphChanges;
                Repaint();
            }
            GUI.EndGroup();
        }

        private void EnsureDependencyGraphLayout(
            IReadOnlyCollection<DependencyNode> nodes,
            IReadOnlyCollection<DependencyEdge> edges)
        {
            var signature = string.Join("|", nodes.Select(node => $"{node.id}:{node.category}")) + "::" +
                            string.Join("|", edges.Select(edge => $"{edge.from}>{edge.to}"));
            if (signature == _dependencyGraphLayoutSignature &&
                nodes.All(node => _dependencyGraphPositions.ContainsKey(node.id)))
                return;

            var preservedPositions = new Dictionary<string, Vector2>(
                _dependencyGraphPositions,
                StringComparer.OrdinalIgnoreCase);
            _dependencyGraphLayoutSignature = signature;
            _dependencyGraphPositions.Clear();
            var incoming = edges
                .GroupBy(edge => edge.to, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);
            var orderedSystems = nodes
                .Where(node => NormalizeCategory(node.category) == "system")
                .OrderByDescending(node => incoming.TryGetValue(node.id, out var count) ? count : 0)
                .ThenBy(node => node.id)
                .ToList();
            var orderedFeatures = nodes
                .Where(node => node.category == "feature")
                .OrderBy(node => node.id)
                .ToList();
            var orderedChanges = nodes
                .Where(node => node.category == "change")
                .OrderBy(node => node.id)
                .ToList();

            var centerNode = orderedSystems.FirstOrDefault() ?? orderedFeatures.FirstOrDefault();
            if (centerNode != null)
                _dependencyGraphPositions[centerNode.id] = Vector2.zero;
            PlaceDependencyGraphRing(
                orderedSystems.Where(node => node != centerNode).ToList(),
                new Vector2(190f, 80f),
                -Mathf.PI * 0.5f);
            PlaceDependencyGraphRing(
                orderedFeatures.Where(node => node != centerNode).ToList(),
                orderedSystems.Count > 0
                    ? new Vector2(285f, 110f)
                    : new Vector2(190f, 80f),
                0f);
            PlaceDependencyGraphRing(
                orderedChanges.Where(node => node != centerNode).ToList(),
                new Vector2(350f, 150f),
                Mathf.PI * 0.25f);
            foreach (var node in nodes)
            {
                if (preservedPositions.TryGetValue(node.id, out var position))
                    _dependencyGraphPositions[node.id] = position;
            }
            if (!_showDependencyGraphChanges)
            {
                foreach (var item in preservedPositions.Where(item =>
                             item.Key.StartsWith("change:", StringComparison.OrdinalIgnoreCase)))
                    _dependencyGraphPositions[item.Key] = item.Value;
            }
        }

        private void PlaceDependencyGraphRing(
            IReadOnlyList<DependencyNode> nodes,
            Vector2 radius,
            float angleOffset)
        {
            for (var index = 0; index < nodes.Count; index++)
            {
                var angle = angleOffset + Mathf.PI * 2f * index / Mathf.Max(1, nodes.Count);
                _dependencyGraphPositions[nodes[index].id] =
                    new Vector2(Mathf.Cos(angle) * radius.x, Mathf.Sin(angle) * radius.y);
            }
        }

        private Rect DependencyGraphNodeRect(Rect canvas, string nodeId)
        {
            var worldPosition = _dependencyGraphPositions.TryGetValue(nodeId, out var value)
                ? value
                : Vector2.zero;
            var center = canvas.center + _dependencyGraphPan + worldPosition * _dependencyGraphZoom;
            var nodeSize = new Vector2(160f, 76f) * _dependencyGraphZoom;
            return new Rect(
                center.x - nodeSize.x * 0.5f,
                center.y - nodeSize.y * 0.5f,
                nodeSize.x,
                nodeSize.y);
        }

        private void HandleDependencyGraphInput(
            Rect canvas,
            IReadOnlyDictionary<string, Rect> nodeRects,
            Rect reservedRect)
        {
            var currentEvent = Event.current;
            var mouse = currentEvent.mousePosition;
            if (!canvas.Contains(mouse) && currentEvent.type != EventType.MouseUp)
                return;
            if (reservedRect.Contains(mouse) &&
                string.IsNullOrEmpty(_draggedDependencyGraphNode) &&
                !_draggingDependencyGraphCanvas)
                return;

            var hoveredNode = nodeRects.FirstOrDefault(pair => pair.Value.Contains(mouse));
            switch (currentEvent.type)
            {
                case EventType.ScrollWheel:
                {
                    var oldZoom = _dependencyGraphZoom;
                    var worldAtMouse = (mouse - canvas.center - _dependencyGraphPan) / oldZoom;
                    _dependencyGraphZoom = Mathf.Clamp(oldZoom * (1f - currentEvent.delta.y * 0.06f), 0.55f, 1.8f);
                    _dependencyGraphPan = mouse - canvas.center - worldAtMouse * _dependencyGraphZoom;
                    MarkDependencyGraphLayoutChanged();
                    currentEvent.Use();
                    Repaint();
                    break;
                }
                case EventType.MouseDown when currentEvent.button == 0:
                    _dependencyGraphLastMouse = mouse;
                    if (!string.IsNullOrEmpty(hoveredNode.Key))
                    {
                        _draggedDependencyGraphNode = hoveredNode.Key;
                        _dependencyGraphDragOffset = mouse - hoveredNode.Value.center;
                        _dependencyGraphNodeMoved = false;
                    }
                    else
                    {
                        _draggingDependencyGraphCanvas = true;
                    }
                    currentEvent.Use();
                    break;
                case EventType.MouseDrag when currentEvent.button == 0:
                    if (!string.IsNullOrEmpty(_draggedDependencyGraphNode))
                    {
                        var desiredCenter = mouse - _dependencyGraphDragOffset;
                        _dependencyGraphPositions[_draggedDependencyGraphNode] =
                            (desiredCenter - canvas.center - _dependencyGraphPan) / _dependencyGraphZoom;
                        MarkDependencyGraphLayoutChanged();
                        _dependencyGraphNodeMoved |= Vector2.Distance(mouse, _dependencyGraphLastMouse) > 2f;
                    }
                    else if (_draggingDependencyGraphCanvas)
                    {
                        _dependencyGraphPan += mouse - _dependencyGraphLastMouse;
                        MarkDependencyGraphLayoutChanged();
                    }
                    _dependencyGraphLastMouse = mouse;
                    currentEvent.Use();
                    Repaint();
                    break;
                case EventType.MouseUp when currentEvent.button == 0:
                    if (!string.IsNullOrEmpty(_draggedDependencyGraphNode) &&
                        !_dependencyGraphNodeMoved)
                        _selectedDependencyGraphNode = _draggedDependencyGraphNode;
                    _draggedDependencyGraphNode = null;
                    _draggingDependencyGraphCanvas = false;
                    currentEvent.Use();
                    Repaint();
                    break;
            }
        }

        private void DrawDependencyGraphGrid(Rect canvas)
        {
            var spacing = Mathf.Max(24f, 42f * _dependencyGraphZoom);
            var gridColor = AgentWorkbenchTheme.IsDarkMode
                ? new Color(1f, 1f, 1f, 0.045f)
                : new Color(0f, 0f, 0f, 0.055f);
            var startX = Mathf.Repeat(_dependencyGraphPan.x + canvas.width * 0.5f, spacing);
            var startY = Mathf.Repeat(_dependencyGraphPan.y + canvas.height * 0.5f, spacing);
            for (var x = startX; x < canvas.width; x += spacing)
                EditorGUI.DrawRect(new Rect(x, 0f, 1f, canvas.height), gridColor);
            for (var y = startY; y < canvas.height; y += spacing)
                EditorGUI.DrawRect(new Rect(0f, y, canvas.width, 1f), gridColor);
        }

        private static void DrawDependencyGraphEdge(Rect fromRect, Rect toRect, DependencyEdge edge)
        {
            var from = fromRect.center;
            var to = toRect.center;
            var direction = (to - from).normalized;
            if (direction.sqrMagnitude < 0.001f)
                return;
            var start = from + direction * DistanceToGraphNodeBorder(fromRect, direction);
            var end = to - direction * DistanceToGraphNodeBorder(toRect, -direction);
            var blocked = edge.blocksImplementation && edge.status != "resolved";
            var scale = Mathf.Clamp(fromRect.width / 160f, 0.55f, 1.8f);
            Handles.color = blocked
                ? new Color(0.95f, 0.28f, 0.25f, 0.9f)
                : new Color(0.62f, 0.68f, 0.78f, 0.72f);
            Handles.DrawAAPolyLine((blocked ? 3f : 2f) * scale, start, end);
            var perpendicular = new Vector2(-direction.y, direction.x);
            var arrowBase = end - direction * 10f * scale;
            Handles.DrawAAConvexPolygon(
                end,
                arrowBase + perpendicular * 4.5f * scale,
                arrowBase - perpendicular * 4.5f * scale);
        }

        private static float DistanceToGraphNodeBorder(Rect rect, Vector2 direction)
        {
            var horizontal = Mathf.Abs(direction.x) > 0.0001f
                ? rect.width * 0.5f / Mathf.Abs(direction.x)
                : float.PositiveInfinity;
            var vertical = Mathf.Abs(direction.y) > 0.0001f
                ? rect.height * 0.5f / Mathf.Abs(direction.y)
                : float.PositiveInfinity;
            return Mathf.Min(horizontal, vertical);
        }

        private static Rect DependencyGraphMainNodeRect(Rect rect)
        {
            var scale = Mathf.Clamp(rect.width / 160f, 0.55f, 1.8f);
            return new Rect(rect.x, rect.y, rect.width, 52f * scale);
        }

        private void DrawDependencyGraphNode(Rect rect, DependencyNode node, bool selected, int pendingDeltaCount)
        {
            var scale = Mathf.Clamp(rect.width / 160f, 0.55f, 1.8f);
            var mainRect = DependencyGraphMainNodeRect(rect);
            var fill = node.category switch
            {
                "architecture" => new Color(0.20f, 0.39f, 0.67f, 0.96f),
                "system" => new Color(0.20f, 0.39f, 0.67f, 0.96f),
                "change" => new Color(0.48f, 0.25f, 0.62f, 0.96f),
                _ => new Color(0.17f, 0.52f, 0.39f, 0.96f)
            };
            var blocked = string.Equals(node.readiness, "blocked", StringComparison.OrdinalIgnoreCase);
            var border = selected
                ? new Color(1f, 0.78f, 0.22f)
                : blocked
                    ? new Color(1f, 0.35f, 0.28f)
                    : Color.Lerp(fill, Color.white, 0.42f);
            var borderWidth = Mathf.Max(1f, 2f * scale);
            EditorGUI.DrawRect(
                new Rect(mainRect.x + 3f * scale, mainRect.y + 4f * scale, mainRect.width, mainRect.height),
                new Color(0f, 0f, 0f, 0.24f));
            EditorGUI.DrawRect(mainRect, fill);
            EditorGUI.DrawRect(new Rect(mainRect.x, mainRect.y, mainRect.width, borderWidth), border);
            EditorGUI.DrawRect(new Rect(mainRect.x, mainRect.yMax - borderWidth, mainRect.width, borderWidth), border);
            EditorGUI.DrawRect(new Rect(mainRect.x, mainRect.y, borderWidth, mainRect.height), border);
            EditorGUI.DrawRect(new Rect(mainRect.xMax - borderWidth, mainRect.y, borderWidth, mainRect.height), border);
            var style = new GUIStyle(EditorStyles.label)
            {
                alignment = TextAnchor.MiddleCenter,
                fontStyle = FontStyle.Bold,
                fontSize = Mathf.Max(6, Mathf.RoundToInt(11f * scale)),
                wordWrap = true,
                normal = { textColor = Color.white }
            };
            GUI.Label(
                mainRect,
                new GUIContent(
                    DependencyDisplayName(node.id, new[] { node }),
                    $"{node.id}\n{L("graph.nodeTip")}"),
                style);

            var status = pendingDeltaCount > 0 ? "delta-pending" : node.readiness;
            var statusLabel = pendingDeltaCount > 0
                ? $"{GraphReadinessLabel(status)} · {pendingDeltaCount}"
                : GraphReadinessLabel(status);
            DrawDependencyGraphStatusHandle(mainRect, status, statusLabel, scale);
        }

        private static void DrawDependencyGraphStatusHandle(
            Rect mainRect,
            string status,
            string label,
            float scale)
        {
            var handleSize = new Vector2(132f, 18f) * scale;
            var handleRect = new Rect(
                mainRect.center.x - handleSize.x * 0.5f,
                mainRect.yMax + 4f * scale,
                handleSize.x,
                handleSize.y);
            var statusColor = GraphStatusTextColor(status);
            var fill = AgentWorkbenchTheme.IsDarkMode
                ? new Color(0.10f, 0.11f, 0.13f, 0.98f)
                : new Color(0.94f, 0.95f, 0.97f, 0.98f);
            var borderWidth = Mathf.Max(1f, scale);
            EditorGUI.DrawRect(handleRect, fill);
            EditorGUI.DrawRect(new Rect(handleRect.x, handleRect.y, handleRect.width, borderWidth), statusColor);
            EditorGUI.DrawRect(new Rect(handleRect.x, handleRect.yMax - borderWidth, handleRect.width, borderWidth), statusColor);
            EditorGUI.DrawRect(new Rect(handleRect.x, handleRect.y, borderWidth, handleRect.height), statusColor);
            EditorGUI.DrawRect(new Rect(handleRect.xMax - borderWidth, handleRect.y, borderWidth, handleRect.height), statusColor);
            GUI.Label(
                handleRect,
                label,
                new GUIStyle(EditorStyles.miniBoldLabel)
                {
                    alignment = TextAnchor.MiddleCenter,
                    fontSize = Mathf.Max(6, Mathf.RoundToInt(9f * scale)),
                    clipping = TextClipping.Clip,
                    normal = { textColor = statusColor }
                });
        }

        private void DrawDependencyGraphInfo(
            IReadOnlyCollection<DependencyNode> nodes,
            IReadOnlyCollection<DependencyEdge> edges,
            IReadOnlyDictionary<string, SpecFile> specsByCapability,
            float height)
        {
            var selected = nodes.FirstOrDefault(node => string.Equals(
                node.id,
                _selectedDependencyGraphNode,
                StringComparison.OrdinalIgnoreCase));
            using (new EditorGUILayout.VerticalScope("box", GUILayout.Height(height)))
            {
                _dependencyGraphInfoScroll.x = 0f;
                _dependencyGraphInfoScroll = BeginVerticalScrollView(
                    _dependencyGraphInfoScroll,
                    GUILayout.ExpandWidth(true),
                    GUILayout.Height(Mathf.Max(80f, height - 8f)));
                if (selected == null)
                {
                    EditorGUILayout.LabelField(L("graph.select"), EditorStyles.centeredGreyMiniLabel);
                    EditorGUILayout.EndScrollView();
                    return;
                }

                var nodesById = nodes.ToDictionary(
                    node => node.id,
                    StringComparer.OrdinalIgnoreCase);
                var dependencies = edges.Where(edge => string.Equals(
                    edge.from,
                    selected.id,
                    StringComparison.OrdinalIgnoreCase)).ToList();
                var dependents = edges.Where(edge => string.Equals(
                    edge.to,
                    selected.id,
                    StringComparison.OrdinalIgnoreCase)).ToList();
                var selectedChange = ChangeForGraphNode(selected);
                var pendingChanges = selectedChange == null
                    ? PendingDeltaChanges(selected.id)
                    : new List<ChangeEntry>();
                var titleStyle = new GUIStyle(EditorStyles.boldLabel)
                {
                    fontSize = 14,
                    normal = { textColor = GraphCategoryColor(selected.category) }
                };
                using (new EditorGUILayout.HorizontalScope())
                {
                    EditorGUILayout.LabelField(DependencyDisplayName(selected.id, new[] { selected }), titleStyle);
                    var selectedStatus = pendingChanges.Count > 0 ? "delta-pending" : selected.readiness;
                    var selectedStatusLabel = pendingChanges.Count > 0
                        ? $"{GraphReadinessLabel(selectedStatus)} · {pendingChanges.Count}"
                        : GraphReadinessLabel(selectedStatus);
                    GUILayout.Label(
                        selectedStatusLabel,
                        GraphReadinessStyle(selectedStatus),
                        GUILayout.Width(170));
                    if (selectedChange != null &&
                        GUILayout.Button(L("graph.viewChange"), ReportActionButtonStyle(), GUILayout.Width(132), GUILayout.Height(24)))
                    {
                        SelectGraphChange(selectedChange);
                    }
                    else if (specsByCapability.TryGetValue(selected.id, out var spec) &&
                        GUILayout.Button(L("graph.viewSpec"), ReportActionButtonStyle(), GUILayout.Width(132), GUILayout.Height(24)))
                    {
                        _tab = ToolTab.OpenSpec;
                        _openSpecSection = OpenSpecSection.Specs;
                        SelectDocument(spec.Path);
                    }
                }

                var wrapStyle = new GUIStyle(EditorStyles.label)
                {
                    wordWrap = true,
                    stretchHeight = true
                };
                EditorGUILayout.LabelField(selectedChange?.Name ?? selected.id, ReportMutedStyle());
                var blockedEdges = dependencies
                    .Where(edge => edge.blocksImplementation && edge.status != "resolved")
                    .ToList();
                var blockingCount = blockedEdges.Count;
                if (blockingCount == 0 && selectedChange != null && selected.readiness == "blocked")
                    blockingCount = 1;
                using (new EditorGUILayout.HorizontalScope())
                {
                    DrawGraphInfoCard(L("graph.direct"), $"{dependencies.Count} · {GraphRelationSummary(dependencies, edge => edge.to, nodesById)}", wrapStyle);
                    DrawGraphInfoCard(L("graph.dependents"), $"{dependents.Count} · {GraphRelationSummary(dependents, edge => edge.from, nodesById)}", wrapStyle);
                    DrawGraphInfoCard(L("common.blocking"), blockingCount.ToString(), wrapStyle, blockingCount > 0);
                    DrawGraphInfoCard(L("graph.pendingDeltas"), pendingChanges.Count.ToString(), wrapStyle, pendingChanges.Count > 0);
                }
                using (new EditorGUILayout.HorizontalScope())
                {
                    DrawGraphBlockingLinks(blockedEdges, nodesById);
                    DrawGraphPendingLinks(pendingChanges);
                }

                var implementationOutline = selectedChange != null
                    ? selectedChange.ImplementationOutlines.Values.SelectMany(items => items).Distinct().ToArray()
                    : specsByCapability.TryGetValue(selected.id, out var selectedSpec)
                        ? selectedSpec.ImplementationOutline
                        : pendingChanges
                        .SelectMany(change => change.ImplementationOutlines.TryGetValue(selected.id, out var outline)
                            ? outline
                            : Enumerable.Empty<string>())
                        .Distinct()
                        .ToArray();
                DrawGraphInfoCard(
                    L("graph.implementationOutline"),
                    implementationOutline.Count > 0
                        ? $"• {string.Join("\n• ", implementationOutline)}"
                        : L("graph.implementationOutlineEmpty"),
                    wrapStyle);
                EditorGUILayout.EndScrollView();
            }
        }

