        {
          "optionText": "绕开足迹，保留体力",
          "checkType": "None",
          "checkTarget": 0,
          "successText": "你们放弃了捷径，但没有惊动留下足迹的东西。",
          "successEffects": [],
          "failText": "",
          "failEffects": [],
          "alwaysAvailable": true,
          "conditions": []
        }
      ],
      "immediateEffects": [],
      "minYear": 1,
