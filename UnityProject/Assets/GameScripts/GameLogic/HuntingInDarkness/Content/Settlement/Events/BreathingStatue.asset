  eventName: "\u4F1A\u547C\u5438\u7684\u77F3\u50CF"
  eventType: 1
  displayText: "\u8425\u5730\u5916\u65B0\u7ACB\u8D77\u4E00\u5C0A\u6CA1\u4EBA\u89C1\u8FC7\u7684\u77F3\u50CF\u3002\u80F8\u8154\u822C\u7684\u88C2\u7F1D\u7F13\u6162\u5F00\u5408\uFF0C\u91CC\u9762\u4F20\u51FA\u4E0E\u4F60\u4EEC\u8BED\u8A00\u76F8\u4F3C\u3001\u5374\u603B\u6162\u534A\u62CD\u7684\u4F4E\u8BED\u3002"
  hiddenText: "\u7406\u89E3\u4F4E\u8BED\u53EF\u80FD\u627E\u5230\u77F3\u50CF\u5185\u90E8\u7684\u50A8\u85CF\uFF0C\u4E5F\u53EF\u80FD\u8BA9\u58F0\u97F3\u7559\u5728\u730E\u4EBA\u7684\u610F\u8BC6\u91CC\u3002"
  options:
  - optionText: "\u8BA9\u4E00\u540D\u730E\u4EBA\u9760\u8FD1\u5E76\u89E3\u8BFB\u523B\u75D5"
