      value: 2
      description: "\u4ECE\u77F3\u50CF\u6697\u683C\u4E2D\u53D6\u51FA\u53EF\u7528\u77F3\u6599\u3002"
    successChain: []
    failText: "\u523B\u75D5\u6CA1\u6709\u7ED9\u51FA\u7B54\u6848\uFF0C\u4F4E\u8BED\u5374\u7559\u5728\u4E86\u730E\u4EBA\u7684\u610F\u8BC6\u91CC\u3002\u538B\u6291
